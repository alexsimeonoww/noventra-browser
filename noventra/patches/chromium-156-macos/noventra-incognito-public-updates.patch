+int BrowserWidget::GetNonClientComponent(const gfx::Point& point) {
+  const int physical_component = views::Widget::GetNonClientComponent(point);
+  auto* browser = browser_view_->browser();
+  auto* selected = noventra::SelectedIncognitoBrowser(browser);
+  if (noventra::IncognitoSpaceHost(browser) == browser && selected &&
+      selected != browser && !selected->IsDeleteScheduled() &&
+      !ui::IsResizingComponent(physical_component)) {
+    auto* selected_view = BrowserView::GetBrowserViewForBrowser(selected);
+    auto* selected_widget =
+        selected_view ? selected_view->browser_widget() : nullptr;
+    if (selected_widget && selected_widget->IsVisible() &&
+        selected_widget->GetRootView()) {
+      gfx::Point selected_point =
+          views::View::ConvertPointToScreen(GetRootView(), point);
+      views::View::ConvertPointFromScreen(selected_widget->GetRootView(),
+                                          &selected_point);
+      if (selected_widget->GetRootView()->GetLocalBounds().Contains(
+              selected_point)) {
+        // The private widget uses its own frame. Its host differs from itself,
+        // so the same override falls through to Widget without recursion.
+        return selected_widget->GetNonClientComponent(selected_point);
+      }
+    }
+  }
+  // Physical outer resize borders always belong to the real OS window.
+  return physical_component;
+}
