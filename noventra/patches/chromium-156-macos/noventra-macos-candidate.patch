+      {"arch", std::string(UpdateQueryParams::GetArch())},
+      {"prod", UpdateQueryParams::GetProdIdString(UpdateQueryParams::CRX)},
+      {"prodchannel", "stable"},
+      {"prodversion", UpdateQueryParams::GetProdVersion()},
+      {"lang", "en-US"},
