+    } catch {
+      if (this.pc === pc) this.fail('That code could not establish a connection. Create new codes, or use a file.');
+    }
+  }
+
+  async acceptAnswer(code: string): Promise<void> {
+    const answer = parseTransferConnectionCode(code);
