+      return "sync_temporarily_unavailable";
+    case E::kQuotaExceeded:
+      return "sync_quota_exceeded";
+    case E::kAborted:
+      return "sync_aborted";
+    case E::kInvalidVaultKey:
+      return "invalid_recovery_key";
+    case E::kAuthenticationFailed:
