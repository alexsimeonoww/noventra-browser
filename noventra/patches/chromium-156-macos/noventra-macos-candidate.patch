+bool WaylandWindow::SupportsBackgroundBlur() const {
+  auto* manager = connection_->background_effect_manager();
+  return root_surface_ && !background_blur_failed_ && manager &&
+         manager->supports_blur();
+}
+
+bool WaylandWindow::SetBackgroundBlurRegion(
+    const std::vector<gfx::Rect>& region_px) {
+  if (!root_surface_) {
+    return false;
+  }
+  if (region_px.empty() || !SupportsBackgroundBlur()) {
+    root_surface_->SetBackgroundBlurRegion({});
+    return false;
+  }
+  if (!root_surface_->SetBackgroundBlurRegion(region_px)) {
+    OnBackgroundBlurFailure();
+    return false;
+  }
+  return true;
+}
+
+void WaylandWindow::SetBackgroundBlurChangedCallback(
+    base::RepeatingClosure callback) {
+  background_blur_changed_callback_ = std::move(callback);
+}
+
+void WaylandWindow::OnBackgroundBlurCapabilitiesChanged() {
+  background_blur_failed_ = false;
+  if (root_surface_) {
+    root_surface_->SetBackgroundBlurRegion({});
+  }
+  NotifyBackgroundBlurChanged();
+}
+
+void WaylandWindow::OnBackgroundBlurFailure() {
+  if (background_blur_failed_) {
+    return;
+  }
+  background_blur_failed_ = true;
+  // Failure can occur while applying a frame's scale. Do not reenter frame
+  // playback through browser layout/theme updates.
+  ui_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WaylandWindow::NotifyBackgroundBlurChanged, AsWeakPtr()));
+}
+
+void WaylandWindow::NotifyBackgroundBlurChanged() {
+  if (background_blur_changed_callback_) {
+    background_blur_changed_callback_.Run();
+  }
+}
