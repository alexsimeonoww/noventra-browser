+  EXPECT_FALSE(ValidateWorkspaceSyncApplyCapacity({}, {}, {}, {}).has_value());
+  WorkspaceSyncMapping mapping{{kWorkspaceSyncPersonalId, ""}};
+  EXPECT_TRUE(ValidateWorkspaceSyncIdentityCapacity(mapping, {}).has_value());
+  EXPECT_TRUE(
