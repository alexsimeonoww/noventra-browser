+bool LocationBarView::IsNoventraAddressCollapsed() const {
+  if (browser_) {
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser_);
+    if (view && view->noventra_dock_controller() && view->noventra_dock_controller()->active()) return false;
+  }
+  const auto* layout = browser_ ? HeliumLayoutStateController::From(browser_) : nullptr;
+  if (layout && layout->IsVerticalLayout() &&
+      browser_->GetProfile()->GetPrefs()->GetBoolean(
+          "noventra.browser.sidebar_controls")) {
+    return false;
+  }
+  if (!browser_ || !IsInitialized() || IsFocusWithin() ||
+      !browser_->GetProfile()->GetPrefs()->GetBoolean(
+          "noventra.browser.address_on_demand")) {
+    return false;
+  }
+  for (const ContentSettingImageView* view : content_setting_views_) {
+    if (view->GetVisible()) {
+      return false;
+    }
+  }
+  if ((extension_debugger_warning_view_ &&
+       extension_debugger_warning_view_->GetVisible()) ||
+      (ai_mode_hint_label_ && ai_mode_hint_label_->GetVisible())) {
+    return false;
+  }
+  if (page_action_container_) {
+    const auto* bookmark =
+        page_action_container_->GetPageActionView(kActionBookmarkThisTab);
+    for (const views::View* child : page_action_container_->children()) {
+      const auto* action = views::AsViewClass<const page_actions::PageActionView>(child);
+      // Flex layout hides decorations when the resting field has zero width.
+      // Consult the model so zoom, permissions and other actions can reopen it.
+      if (child != bookmark &&
+          (action ? action->GetDeclaredVisible() : child->GetVisible())) {
+        return false;
+      }
+    }
+  }
+  const auto* controller = HeliumLayoutStateController::From(browser_);
+  // Keep the real location bar and security/permission anchors alive. Expand
+  // for active permission chips or security labels rather than clipping them.
+  return controller && (controller->IsCompactLayout() || controller->IsVerticalLayout()) &&
+         !GetOmniboxController()->edit_model()->user_input_in_progress() &&
+         !GetOmniboxController()->IsPopupOpen() &&
+         !location_icon_view_->GetShowText() &&
+         !GetProperty(kNoventraPageInfoOpenKey) &&
+         !(chip_view_ && chip_view_->GetVisible()) &&
+         !(permission_dashboard_view_ && permission_dashboard_view_->GetVisible());
+}
