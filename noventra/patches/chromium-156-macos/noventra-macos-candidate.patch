+void BrowserDesktopWindowTreeHostWin::UpdateNoventraDesktopGlass(bool force) {
+  if (updating_noventra_glass_ || native_window_destroying_ || !browser_view_ ||
+      !browser_view_->GetIsNormalType() || !GetWidget() ||
+      !GetWidget()->IsNativeWidgetInitialized() || !GetHWND()) {
+    return;
+  }
+
+  auto* native_widget = views::DesktopNativeWidgetAura::ForWindow(window());
+  base::AutoReset<bool> updating(&updating_noventra_glass_, true);
+
+  const bool supported =
+      base::win::GetVersion() >= base::win::Version::WIN11_22H2;
+  BOOL composition_enabled = FALSE;
+  const bool composition_available =
+      supported && SUCCEEDED(DwmIsCompositionEnabled(&composition_enabled)) &&
+      composition_enabled;
+  const LONG style = GetWindowLong(GetHWND(), GWL_STYLE);
+  const LONG ex_style = GetWindowLong(GetHWND(), GWL_EXSTYLE);
+  const bool requested =
+      native_widget && helium::WantsNoventraGlass(browser_view_) &&
+      composition_available && ShouldUseNativeFrame() && !IsFullscreen() &&
+      CanResize() && CanMaximize() && (style & WS_THICKFRAME) &&
+      (style & WS_MAXIMIZEBOX) && !(ex_style & WS_EX_LAYERED);
+  const bool dark_mode =
+      GetWidget()->GetColorMode() == ui::ColorProviderKey::ColorMode::kDark;
+  if (!force && last_noventra_glass_request_ == requested &&
+      (!requested || last_noventra_glass_dark_mode_ == dark_mode)) {
+    return;
+  }
+
+  bool available = false;
+  if (requested) {
+    // Desktop Acrylic samples the desktop behind the window. MAINWINDOW is
+    // Mica and does not provide the requested live desktop glass effect.
+    const BOOL use_dark_mode = dark_mode;
+    const DWM_SYSTEMBACKDROP_TYPE backdrop = DWMSBT_TRANSIENTWINDOW;
+    const MARGINS margins = {-1, -1, -1, -1};
+    available =
+        SUCCEEDED(
+            DwmSetWindowAttribute(GetHWND(), DWMWA_USE_IMMERSIVE_DARK_MODE,
+                                  &use_dark_mode, sizeof(use_dark_mode))) &&
+        SUCCEEDED(DwmSetWindowAttribute(GetHWND(), DWMWA_SYSTEMBACKDROP_TYPE,
+                                        &backdrop, sizeof(backdrop))) &&
+        SUCCEEDED(DwmExtendFrameIntoClientArea(GetHWND(), &margins));
+  }
+
+  bool reset_succeeded = true;
+  if (!available && supported) {
+    // Also undo partial success. Even if DWM refuses a reset, keep the Aura
+    // surface opaque and retry on the next update instead of exposing it.
+    const DWM_SYSTEMBACKDROP_TYPE backdrop = DWMSBT_NONE;
+    const MARGINS margins = {};
+    const HRESULT backdrop_result = DwmSetWindowAttribute(
+        GetHWND(), DWMWA_SYSTEMBACKDROP_TYPE, &backdrop, sizeof(backdrop));
+    const HRESULT margins_result =
+        DwmExtendFrameIntoClientArea(GetHWND(), &margins);
+    reset_succeeded = SUCCEEDED(backdrop_result) && SUCCEEDED(margins_result);
+  }
+
+  noventra_glass_active_ = available;
+  last_noventra_glass_request_.reset();
+  if (native_widget && (available || (!requested && reset_succeeded))) {
+    last_noventra_glass_request_ = requested;
+  }
+  last_noventra_glass_dark_mode_ = dark_mode;
+  browser_view_->SetNoventraDesktopGlassAvailable(available);
+  // This changes the compositor and browser root surfaces, not WebContents or
+  // InitParams::opacity. Using kTranslucent would disable resize/maximize.
+  if (native_widget) {
+    native_widget->UpdateWindowTransparency();
+  }
+}
