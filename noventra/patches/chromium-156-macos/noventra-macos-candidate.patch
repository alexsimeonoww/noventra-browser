+                          kColorTabForegroundInactiveFrameActive,
+                          kColorTabForegroundInactiveFrameInactive,
+                          kColorNewTabButtonCRForegroundFrameActive,
+                          kColorNewTabButtonCRForegroundFrameInactive}) {
+      mixer[id] = {kColorToolbarText};
