+      const navigation = moving.filter(item => !['address', 'extensions', 'menu'].includes(item.id));
+      const address = moving.filter(item => item.id === 'address');
+      const tools = moving.filter(item => ['extensions', 'menu'].includes(item.id));
+      peers.splice(tabsIndex < 0 ? peers.length : tabsIndex, 0, ...navigation, ...address, ...tools);
