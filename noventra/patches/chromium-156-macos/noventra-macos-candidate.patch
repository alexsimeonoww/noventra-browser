+namespace noventra {
+namespace {
+
+constexpr SpaceTheme kSpaceThemes[] = {
+    {"white-glass", false, true, 0},     {"black-glass", true, true, 0},
+    {"solid-white", false, false, 0},    {"solid-black", true, false, 0},
+    {"forest", true, false, 0xff397a58}, {"ocean", true, false, 0xff2563a8},
+    {"sand", false, false, 0xffb99a66},
+};
+
+const SpaceTheme* FindSpaceTheme(std::string_view id) {
+  const auto it = std::ranges::find(kSpaceThemes, id, &SpaceTheme::id);
+  return it == std::end(kSpaceThemes) ? nullptr : &*it;
+}
+
+bool IsValidSpaceId(const std::string& id) {
+  return id.empty() || base::Uuid::ParseLowercase(id).is_valid();
+}
+
+bool IsSpaceColor(const std::string& color) {
+  static constexpr std::string_view colors[] = {"default", "red",    "orange",
+                                                "yellow",  "green",  "teal",
+                                                "blue",    "purple", "pink"};
+  return std::ranges::find(colors, color) != std::end(colors);
+}
+
+bool IsSpaceIcon(const std::string& icon) {
+  static constexpr std::string_view icons[] = {
+      "default", "work", "home", "code", "book", "globe", "music", "star"};
+  return std::ranges::find(icons, icon) != std::end(icons);
+}
+
+void AppendSpaceId(std::vector<std::string>& ids, const std::string& id) {
+  if (IsValidSpaceId(id) && std::ranges::find(ids, id) == ids.end()) {
+    ids.push_back(id);
+  }
+}
+
+std::vector<std::string> ReadSpaceOrder(PrefService* prefs) {
+  std::vector<std::string> order;
+  if (prefs->FindPreference(kSpaceOrderPref)) {
+    for (const auto& value : prefs->GetList(kSpaceOrderPref)) {
+      if (value.is_string()) {
+        AppendSpaceId(order, value.GetString());
+      }
+    }
+  }
+  return order;
+}
+
+void SaveSpaceOrder(PrefService* prefs, const std::vector<std::string>& order) {
+  base::ListValue value;
+  for (const auto& id : order) {
+    value.Append(id);
+  }
+  if (prefs->GetList(kSpaceOrderPref) != value) {
+    prefs->SetList(kSpaceOrderPref, std::move(value));
+  }
+}
+
+// Preserve legacy Personal/dictionary/tab-discovery ordering on migration. Use
+// creation order for other windows, so their activation does not reorder
+// spaces. An order/archive entry alone is never evidence that a space exists.
+std::vector<std::string> KnownSpaceIds(BrowserWindowInterface* browser) {
+  std::vector<std::string> ids = {""};
+  Profile* profile = browser->GetProfile();
+  for (const auto [id, name] : profile->GetPrefs()->GetDict(kSpacesPref)) {
+    if (name.is_string()) {
+      AppendSpaceId(ids, id);
+    }
+  }
+  const auto discover = [&](BrowserWindowInterface* candidate) {
+    if (candidate->GetProfile() == profile) {
+      if (auto* model = candidate->GetTabStripModel()) {
+        for (int i = 0; i < model->count(); ++i) {
+          AppendSpaceId(ids, SpaceId(model->GetWebContentsAt(i)));
+        }
+      }
+    }
+    return true;
+  };
+  GlobalBrowserCollection::GetInstance()->ForEach(discover);
+  // A new window can query its spaces before joining the collection.
+  discover(browser);
+  return ids;
+}
+
+}  // namespace
+
+bool IsSpaceArchived(Profile* profile, const std::string& id) {
+  return profile && !id.empty() && IsValidSpaceId(id) &&
+         profile->GetPrefs()->FindPreference(kArchivedSpacesPref) &&
+         profile->GetPrefs()->GetList(kArchivedSpacesPref).contains(id);
+}
+
+bool CanManageSpaces(Profile* profile) {
+  if (!profile) {
+    return false;
+  }
+  const auto* prefs = profile->GetPrefs();
+  for (const char* key : {kSpacesPref, kSpaceOrderPref, kArchivedSpacesPref}) {
+    if (!prefs->FindPreference(key) || prefs->IsManagedPreference(key)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool CanCustomizeSpaceTheme(BrowserWindowInterface* browser) {
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return false;
+  }
+  Profile* profile = browser->GetProfile();
+  if (!profile || profile->ShutdownStarted() || profile->IsOffTheRecord() ||
+      profile->IsGuestSession() || profile->IsEnterpriseIsolatedModeProfile() ||
+      !CanManageSpaces(profile)) {
+    return false;
+  }
+  const auto* prefs = profile->GetPrefs();
+  for (const char* name : {kSpaceAppearancePref, prefs::kBrowserColorScheme,
+                           prefs::kUserColor, prefs::kGrayscaleThemeEnabled,
+                           prefs::kBrowserColorVariant, prefs::kCurrentThemeID,
+#if BUILDFLAG(IS_LINUX)
+                           prefs::kSystemTheme,
+#endif
+                           "noventra.browser.glass_enabled"}) {
+    if (const auto* pref = prefs->FindPreference(name);
+        pref && !pref->IsUserModifiable()) {
+      return false;
+    }
+  }
+  const auto* themes = ThemeServiceFactory::GetForProfile(profile);
+  return themes && !themes->UsingPolicyTheme();
+}
+
+const SpaceTheme* GetSpaceTheme(BrowserWindowInterface* browser) {
+  if (!CanCustomizeSpaceTheme(browser)) {
+    return nullptr;
+  }
+  // Mirrored windows can have no local page, or a local active tab from another
+  // Space. The logical selection is authoritative. Never create a service while
+  // a color provider is being constructed or a window is shutting down.
+  std::string id;
+  if (auto* mirror =
+          WindowMirrorService::GetForProfileIfExisting(browser->GetProfile());
+      mirror && mirror->IsEnrolled(browser)) {
+    id = mirror->SelectedSpace(browser);
+  } else if (auto* model = browser->GetTabStripModel()) {
+    id = SpaceId(model->GetActiveWebContents());
+  }
+  return FindSpaceTheme(GetSpaceAppearance(browser->GetProfile(), id).theme);
+}
+
+SpaceAppearance GetSpaceAppearance(Profile* profile, const std::string& id) {
+  SpaceAppearance result;
+  if (!profile || !IsValidSpaceId(id)) {
+    return result;
+  }
+  const auto* prefs = profile->GetPrefs();
+  if (!prefs->FindPreference(kSpaceAppearancePref)) {
+    return result;
+  }
+  const auto* appearance = prefs->GetDict(kSpaceAppearancePref).FindDict(id);
+  if (appearance) {
+    if (const auto* color = appearance->FindString("color");
+        color && IsSpaceColor(*color)) {
+      result.color = *color;
+    }
+    if (const auto* icon = appearance->FindString("icon");
+        icon && IsSpaceIcon(*icon)) {
+      result.icon = *icon;
+    }
+    if (const auto* theme = appearance->FindString("theme");
+        theme && FindSpaceTheme(*theme)) {
+      result.theme = *theme;
+    }
+  }
+  return result;
+}
+
+bool SetSpaceAppearance(BrowserWindowInterface* browser,
+                        const std::string& id,
+                        const std::string& color,
+                        const std::string& icon,
+                        const std::string& theme) {
+  if (!browser || !CanManageSpaces(browser->GetProfile()) ||
+      !IsValidSpaceId(id) || !IsSpaceColor(color) || !IsSpaceIcon(icon) ||
+      (theme != "browser" && !FindSpaceTheme(theme))) {
+    return false;
+  }
+  auto* prefs = browser->GetProfile()->GetPrefs();
+  if (!prefs->FindPreference(kSpaceAppearancePref) ||
+      prefs->IsManagedPreference(kSpaceAppearancePref)) {
+    return false;
+  }
+  const auto known = KnownSpaceIds(browser);
+  if (std::ranges::find(known, id) == known.end()) {
+    return false;
+  }
+  const auto current = GetSpaceAppearance(browser->GetProfile(), id);
+  if (theme != current.theme && !CanCustomizeSpaceTheme(browser)) {
+    return false;
+  }
+  ScopedDictPrefUpdate update(prefs, kSpaceAppearancePref);
+  if (color == "default" && icon == "default" && theme == "browser") {
+    update->Remove(id);
+  } else {
+    base::DictValue entry;
+    entry.Set("color", color);
+    entry.Set("icon", icon);
+    // Keep inherited legacy entries byte-compatible with color/icon-only data.
+    if (theme != "browser") {
+      entry.Set("theme", theme);
+    }
+    update->Set(id, std::move(entry));
+  }
+  return true;
+}
+
+std::vector<std::string> SpaceIds(BrowserWindowInterface* browser,
+                                  bool include_archived) {
+  if (!browser) {
+    return {};
+  }
+  Profile* profile = browser->GetProfile();
+  auto* prefs = profile->GetPrefs();
+  const auto known = KnownSpaceIds(browser);
+  auto order = ReadSpaceOrder(prefs);
+  for (const auto& id : known) {
+    AppendSpaceId(order, id);
+  }
+  // Retain valid but currently undiscovered order entries: a later restored tab
+  // may be the only remaining evidence for a space whose name pref was lost.
+  if (CanManageSpaces(profile)) {
+    SaveSpaceOrder(prefs, order);
+  }
+  std::erase_if(order, [&](const std::string& id) {
+    return std::ranges::find(known, id) == known.end() ||
+           (!include_archived && IsSpaceArchived(profile, id));
+  });
+  return order;
+}
+
+bool SetSpaceName(BrowserWindowInterface* browser,
+                  const std::string& id,
+                  const std::string& name,
+                  bool create) {
+  std::string trimmed;
+  base::TrimWhitespaceASCII(name, base::TRIM_ALL, &trimmed);
+  if (!browser || !CanManageSpaces(browser->GetProfile()) ||
+      !IsValidSpaceId(id) || trimmed.empty() || trimmed.size() > 160 ||
+      !base::IsStringUTF8(trimmed)) {
+    return false;
+  }
+  auto* prefs = browser->GetProfile()->GetPrefs();
+  const auto known = KnownSpaceIds(browser);
+  const bool exists = std::ranges::find(known, id) != known.end();
+  auto order = ReadSpaceOrder(prefs);
+  if (create) {
+    if (id.empty() || exists || std::ranges::find(order, id) != order.end() ||
+        IsSpaceArchived(browser->GetProfile(), id)) {
+      return false;
+    }
+  } else if (!exists) {
+    return false;
+  }
+  for (const auto& known_id : known) {
+    AppendSpaceId(order, known_id);
+  }
+  if (create) {
+    order.push_back(id);
+  }
+  // Seed the old order BEFORE inserting the new dictionary key. Otherwise a
+  // newly generated UUID can sort ahead of older spaces during pref callbacks.
+  SaveSpaceOrder(prefs, order);
+  ScopedDictPrefUpdate update(prefs, kSpacesPref);
+  update->Set(id, trimmed);
+  return true;
+}
+
+bool MoveSpace(BrowserWindowInterface* browser,
+               const std::string& id,
+               const std::string& target,
+               bool after) {
+  if (!browser || !CanManageSpaces(browser->GetProfile()) || id == target ||
+      !IsValidSpaceId(id) || !IsValidSpaceId(target)) {
+    return false;
+  }
+  const auto known = KnownSpaceIds(browser);
+  if (std::ranges::find(known, id) == known.end() ||
+      std::ranges::find(known, target) == known.end()) {
+    return false;
+  }
+  auto* prefs = browser->GetProfile()->GetPrefs();
+  auto order = ReadSpaceOrder(prefs);
+  for (const auto& known_id : known) {
+    AppendSpaceId(order, known_id);
+  }
+  std::erase(order, id);
+  const auto position = std::ranges::find(order, target);
+  order.insert(after ? position + 1 : position, id);
+  SaveSpaceOrder(prefs, order);
+  return true;
+}
+
+bool SetSpaceArchived(BrowserWindowInterface* browser,
+                      const std::string& id,
+                      bool archived) {
+  if (!browser || !CanManageSpaces(browser->GetProfile()) || id.empty() ||
+      !IsValidSpaceId(id)) {
+    return false;
+  }
+  Profile* profile = browser->GetProfile();
+  const auto known = KnownSpaceIds(browser);
+  if (std::ranges::find(known, id) == known.end()) {
+    return false;
+  }
+  auto* prefs = profile->GetPrefs();
+  auto order = ReadSpaceOrder(prefs);
+  for (const auto& known_id : known) {
+    AppendSpaceId(order, known_id);
+  }
+  SaveSpaceOrder(prefs, order);
+  if (!prefs->GetDict(kSpacesPref).FindString(id)) {
+    // Keep a recovered space available in Settings even after its last tab is
+    // closed. This does not alter the authoritative storage partition.
+    ScopedDictPrefUpdate update(prefs, kSpacesPref);
+    update->Set(id, "Account space");
+  }
+  auto archives = prefs->GetList(kArchivedSpacesPref).Clone();
+  archives.EraseValue(base::Value(id));
+  if (archived) {
+    archives.Append(id);
+  }
+  prefs->SetList(kArchivedSpacesPref, std::move(archives));
+  if (archived) {
+    const auto switch_archived = [&](BrowserWindowInterface* candidate) {
+      // Regular-profile prefs may be inherited by an off-the-record window.
+      // Respect each window's effective archive pref, without mixing its tabs
+      // or its account partition with the regular profile's contents.
+      if (candidate->GetProfile()->GetOriginalProfile() ==
+          profile->GetOriginalProfile()) {
+        auto* model = candidate->GetTabStripModel();
+        if (model && !candidate->IsDeleteScheduled() && !model->closing_all() &&
+            SpaceId(model->GetActiveWebContents()) == id &&
+            IsSpaceArchived(candidate->GetProfile(), id)) {
+          SwitchSpace(candidate, "");
+        }
+      }
+      return true;
+    };
+    GlobalBrowserCollection::GetInstance()->ForEach(switch_archived);
+    switch_archived(browser);
+  }
+  return true;
+}
+
+void SwitchSpace(BrowserWindowInterface* browser, const std::string& id) {
+  if (!browser || browser->IsDeleteScheduled() ||
+      !browser->GetTabStripModel() ||
+      browser->GetTabStripModel()->closing_all()) {
+    return;
+  }
+  const auto ids = SpaceIds(browser);
+  if (std::ranges::find(ids, id) == ids.end()) return;
+  if (auto* mirror = WindowMirrorService::GetForProfile(browser->GetProfile());
+      mirror && mirror->IsEnrolled(browser)) {
+    if (mirror->SelectSpace(browser, id) || !mirror->Rows(browser).empty()) {
+      return;
+    }
+  }
+  auto* model = browser->GetTabStripModel();
+  int target = TabStripModel::kNoTab;
+  for (int i = 0; i < model->count(); ++i) {
+    auto* contents = model->GetWebContentsAt(i);
+    if (SpaceId(contents) == id &&
+        (target == TabStripModel::kNoTab || contents->GetLastActiveTimeTicks() >
+             model->GetWebContentsAt(target)->GetLastActiveTimeTicks())) target = i;
+  }
+  if (target != TabStripModel::kNoTab) {
+    model->ActivateTabAt(target);
+    return;
+  }
+  const GURL url("about:blank");
+  content::WebContents::CreateParams params(browser->GetProfile());
+  if (!id.empty()) params.site_instance = SpaceSiteInstance(browser->GetProfile(), url, id);
+  auto contents = content::WebContents::Create(params);
+  contents->GetController().LoadURL(url, content::Referrer(), ui::PAGE_TRANSITION_TYPED, {});
+  if (id.empty() && IsSpaceArchived(browser->GetProfile(),
+                                    SpaceId(model->GetActiveWebContents()))) {
+    // Archive recovery must repair this window, including account popups.
+    // Navigate() can redirect a popup's new tab to a different normal browser,
+    // leaving this window in the archived account. Insert a new Personal tab
+    // locally without inheriting an opener or touching the old document.
+    model->InsertWebContentsAt(model->count(), std::move(contents),
+                               AddTabTypes::ADD_ACTIVE);
+    chrome::FocusLocationBar(browser);
+    return;
+  }
+  NavigateParams navigate(browser, url, ui::PAGE_TRANSITION_TYPED);
+  navigate.contents_to_insert = std::move(contents);
+  navigate.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&navigate);
+  chrome::FocusLocationBar(browser);
+}
+void CycleSpace(BrowserWindowInterface* browser, int direction) {
+  const auto ids = SpaceIds(browser);
+  if (ids.empty()) {
+    return;
+  }
+  auto current = SpaceId(browser->GetTabStripModel()->GetActiveWebContents());
+  if (auto* mirror = WindowMirrorService::GetForProfile(browser->GetProfile());
+      mirror && mirror->IsEnrolled(browser)) {
+    current = mirror->SelectedSpace(browser);
+  }
+  const auto it = std::ranges::find(ids, current);
+  const int index = it == ids.end() ? 0 : it - ids.begin();
+  const int count = static_cast<int>(ids.size());
+  SwitchSpace(browser, ids[(index + direction % count + count) % count]);
+}
+}  // namespace noventra
