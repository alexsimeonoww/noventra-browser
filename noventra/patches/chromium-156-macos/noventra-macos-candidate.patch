+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_NOVENTRA_DOCK_CONTROLLER_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_NOVENTRA_DOCK_CONTROLLER_H_
+#include <map>
+#include <memory>
