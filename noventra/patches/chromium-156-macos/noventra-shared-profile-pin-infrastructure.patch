+class CatalogProfileLease : public base::SupportsUserData::Data {
+ public:
+  explicit CatalogProfileLease(
+      std::unique_ptr<ScopedProfileKeepAlive> keep_alive)
+      : keep_alive_(std::move(keep_alive)) {}
