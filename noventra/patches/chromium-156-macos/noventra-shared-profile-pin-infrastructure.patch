+#ifndef CHROME_BROWSER_PROFILES_NOVENTRA_SPACE_PROFILE_REGISTRY_H_
+#define CHROME_BROWSER_PROFILES_NOVENTRA_SPACE_PROFILE_REGISTRY_H_
