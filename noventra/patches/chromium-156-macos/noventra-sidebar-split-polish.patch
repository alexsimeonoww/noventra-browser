+void ContentsContainerView::OnSplitAction(bool close_pane) {
+  auto* contents = contents_view_->web_contents();
+  auto* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  if (!tab || !tab->IsSplit())
+    return;
+  // Model mutations can replace/destroy this pane. Resolve weak identities on
+  // the next task instead of carrying a raw view through a close callback.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserView> browser,
+             base::WeakPtr<tabs::TabInterface> tab, bool close) {
+            if (!browser || !tab || !tab->IsSplit())
+              return;
+            auto* model = browser->browser()->GetTabStripModel();
+            const int index = model->GetIndexOfTab(tab.get());
+            if (!model->ContainsIndex(index))
+              return;
+            if (close) {
+              model->CloseWebContentsAt(
+                  index, CLOSE_USER_GESTURE | CLOSE_CREATE_HISTORICAL_TAB);
+              return;
+            }
+            model->ActivateTabAt(index);
+            if (browser && tab && tab->GetSplit())
+              browser->browser()->GetTabStripModel()->RemoveSplit(
+                  *tab->GetSplit());
+          },
+          browser_view_->GetAsWeakPtr(), tab->GetWeakPtr(), close_pane));
 }
 
