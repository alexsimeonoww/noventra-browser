+  if (noventra_split_drop_valid_ && target->IsSplit() &&
+      target->GetSplit() != source->GetSplit() &&
+      model->GetSplitData(*target->GetSplit())->ListTabs().size() >= 4) {
+    noventra_split_drop_valid_ = false;
+    label = u"This split already has four tabs";
+  }
+  gfx::Rect target_bounds = page;
+  if (target) {
+    if (auto* pane =
+            browser->multi_contents_view()->GetContentsContainerViewFor(
+                target->GetContents());
+        pane && pane->GetBoundsInScreen().Contains(point)) {
+      target_bounds = pane->GetBoundsInScreen();
+    }
+  }
+  const int band = std::min(64, target_bounds.height() / 4);
+  noventra_split_drop_stacked_ = point.y() < target_bounds.y() + band ||
+                                 point.y() > target_bounds.bottom() - band;
+  noventra_split_drop_after_ =
+      noventra_split_drop_stacked_
+          ? point.y() >= target_bounds.CenterPoint().y()
+          : point.x() >= target_bounds.CenterPoint().x();
+  if (noventra_split_drop_valid_) {
+    auto layout = target->GetSplit() ? model->GetSplitData(*target->GetSplit())
+                                           ->visual_data()
+                                           ->split_layout()
+                                     : split_tabs::SplitTabLayout::kSideBySide;
+    if (noventra_split_drop_stacked_) {
+      layout = split_tabs::SplitTabLayout::kStacked;
+    }
+    if (layout == split_tabs::SplitTabLayout::kGrid) {
+      label = u"Place in split";
+    } else {
+      label =
+          layout == split_tabs::SplitTabLayout::kStacked
+              ? (noventra_split_drop_after_ ? u"Split below" : u"Split above")
+              : (noventra_split_drop_after_ ? u"Split right" : u"Split left");
+    }
+  }
+  const auto bounds =
+      noventra_split_drop_valid_
+          ? browser->multi_contents_view()->GetNoventraSplitDropBounds(
+                source, target, noventra_split_drop_after_,
+                noventra_split_drop_stacked_)
+          : gfx::Rect();
+  browser->multi_contents_view()->ShowNoventraSplitDropPreview(
+      bounds, point, label + u" · " + data().title);
+  return true;
+}
+
+void Tab::ResetNoventraSplitDrag() {
+  noventra_split_drag_reveal_.RunAndReset();
+  noventra_split_drag_pending_ = false;
+  noventra_split_drag_active_ = false;
+  noventra_split_drop_valid_ = false;
+  noventra_split_page_target_.reset();
+  noventra_split_press_event_.reset();
+  noventra_split_original_selection_.Clear();
+}
+
+void Tab::FinishNoventraSplitDrag() {
+  auto* source = tab_handle_.Get();
+  auto* browser = source ? BrowserView::GetBrowserViewForBrowser(
+                               source->GetBrowserWindowInterface())
+                         : nullptr;
+  if (!browser) {
+    ResetNoventraSplitDrag();
+    return;
+  }
+  auto* model = browser->browser()->GetTabStripModel();
+  const int source_index = model->GetIndexOfTab(source);
+  if (!model->ContainsIndex(source_index)) {
+    ResetNoventraSplitDrag();
+    return;
+  }
+  auto weak_source = source->GetWeakPtr();
+  const auto target = noventra_split_page_target_;
+  const bool valid = noventra_split_drop_valid_;
+  const bool after = noventra_split_drop_after_;
+  const bool stacked = noventra_split_drop_stacked_;
+  ResetNoventraSplitDrag();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserView> view,
+             base::WeakPtr<tabs::TabInterface> source,
+             base::WeakPtr<tabs::TabInterface> target, bool valid, bool after,
+             bool stacked) {
+            if (!valid || !view || !source || !target ||
+                !view->GetProfile()->GetPrefs()->GetBoolean(
+                    prefs::kSplitViewDragAndDropEnabled))
+              return;
+            auto* model = view->browser()->GetTabStripModel();
+            if (!model->ContainsIndex(model->GetIndexOfTab(source.get())) ||
+                !model->ContainsIndex(model->GetIndexOfTab(target.get())))
+              return;
+            if (source->IsPinned() != target->IsPinned() ||
+                noventra::SpaceId(source->GetContents()) !=
+                    noventra::SpaceId(target->GetContents()))
+              return;
+            if (!model->JoinNoventraSplit(model->GetIndexOfTab(source.get()),
+                                          model->GetIndexOfTab(target.get())))
+              return;
+            if (!view || !source || !target)
+              return;
+            model = view->browser()->GetTabStripModel();
+            if (!model->ContainsIndex(model->GetIndexOfTab(source.get())) ||
+                !model->ContainsIndex(model->GetIndexOfTab(target.get())))
+              return;
+            const int from = model->GetIndexOfTab(source.get());
+            int to = model->GetIndexOfTab(target.get()) + (after ? 1 : 0);
+            if (from < to)
+              --to;
+            if (model->ContainsIndex(to) && from != to)
+              model->MoveWebContentsAt(from, to, true);
+            if (view && source && stacked && source->GetSplit())
+              view->browser()->GetTabStripModel()->UpdateSplitLayout(
+                  *source->GetSplit(), split_tabs::SplitTabLayout::kStacked);
+          },
+          browser->GetAsWeakPtr(), weak_source, target, valid, after, stacked));
+}
