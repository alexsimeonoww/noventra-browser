+TEST(FreedesktopSecretKeyProviderTest, ReadOnlyImportDoesNotCreateCollection) {
+  auto bus = base::MakeRefCounted<testing::StrictMock<dbus::MockBus>>(
+      dbus::Bus::Options());
+  FreedesktopSecretKeyProvider provider(
+      "gnome-libsecret", kProductName, bus,
+      FreedesktopSecretKeyProvider::ReadOnlyImport{
+          "source-browser", "Source Keys", "Source Safe Storage"});
+  bool failed = false;
+  provider.key_callback_ = base::BindLambdaForTesting(
+      [&](const std::string& tag,
+          base::expected<Encryptor::Key, KeyProvider::KeyError> key) {
+        EXPECT_EQ(tag, "v11");
+        EXPECT_FALSE(key.has_value());
+        failed = true;
+      });
+  provider.OnReadAliasDefault(std::make_tuple(dbus::ObjectPath("/")));
+  EXPECT_TRUE(failed);
+}
