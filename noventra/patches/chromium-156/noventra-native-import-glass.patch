+bool NewTabPageUI::CanShareNoventraGlassBackground(
+    const gfx::RectF& normalized_bounds,
+    const gfx::Size& view_size) const {
+  auto* view = web_contents()->GetRenderWidgetHostView();
+  if (!noventra_foreground_bounds_ || !view || normalized_bounds.IsEmpty() ||
+      noventra_foreground_view_size_ != view_size ||
+      view->GetViewBounds().size() != view_size ||
+      view->GetDeviceScaleFactor() != noventra_foreground_device_scale_ ||
+      !blink::ZoomValuesEqual(
+          content::HostZoomMap::GetZoomLevel(web_contents()),
+          noventra_foreground_zoom_level_)) {
+    VLOG(1) << "NoventraGlass ntp.share rejected_state ntp=" << this
+            << " cached=" << noventra_foreground_bounds_.has_value()
+            << " view=" << (view != nullptr)
+            << " requested=" << normalized_bounds.ToString()
+            << " caller_size=" << view_size.ToString()
+            << " cached_size=" << noventra_foreground_view_size_.ToString()
+            << " native_size="
+            << (view ? view->GetViewBounds().size().ToString() : "none")
+            << " native_scale=" << (view ? view->GetDeviceScaleFactor() : 0)
+            << " cached_scale=" << noventra_foreground_device_scale_
+            << " zoom=" << content::HostZoomMap::GetZoomLevel(web_contents())
+            << " cached_zoom=" << noventra_foreground_zoom_level_;
+    return false;
+  }
+  const bool result = std::ranges::none_of(
+      *noventra_foreground_bounds_, [&](const gfx::RectF& foreground) {
+        return foreground.Intersects(normalized_bounds);
+      });
+  VLOG(1) << "NoventraGlass ntp.share checked ntp=" << this
+          << " result=" << result
+          << " requested=" << normalized_bounds.ToString()
+          << " caller_size=" << view_size.ToString()
+          << " foreground_count=" << noventra_foreground_bounds_->size();
+  if (VLOG_IS_ON(1)) {
+    for (const gfx::RectF& foreground : *noventra_foreground_bounds_) {
+      VLOG(1) << "NoventraGlass ntp.share foreground ntp=" << this
+              << " rect=" << foreground.ToString()
+              << " intersects=" << foreground.Intersects(normalized_bounds);
+    }
+  }
+  return result;
+}
