+bool NewTabPageUI::SetNoventraForegroundBounds(
+    const std::vector<new_tab_page::mojom::NoventraForegroundRectPtr>& bounds,
+    double viewport_width,
+    double viewport_height,
+    double device_pixel_ratio,
+    bool complete) {
+  if (!complete) {
+    VLOG(1) << "NoventraGlass ntp.report ntp=" << this
+            << " complete=0 cached=" << noventra_foreground_bounds_.has_value();
+    InvalidateNoventraForegroundBounds();
+    return true;
+  }
+  auto* view = web_contents()->GetRenderWidgetHostView();
+  const double zoom_level = content::HostZoomMap::GetZoomLevel(web_contents());
+  const float device_scale = view ? view->GetDeviceScaleFactor() : 0;
+  const gfx::Size size = view ? view->GetViewBounds().size() : gfx::Size();
+  const double expected_ratio =
+      device_scale * blink::ZoomLevelToZoomFactor(zoom_level);
+  // CSS viewport dimensions include page zoom; native dimensions are DIPs.
+  // Reject reports from the previous resize/zoom instead of mapping stale
+  // geometry onto a new split pane or window size. Allow CSS pixel rounding.
+  if (!view || size.IsEmpty() || bounds.empty() || bounds.size() > 16 ||
+      !std::isfinite(viewport_width) || !std::isfinite(viewport_height) ||
+      !std::isfinite(device_pixel_ratio) || viewport_width <= 0 ||
+      viewport_height <= 0 || device_pixel_ratio <= 0 ||
+      device_pixel_ratio > 32 ||
+      std::abs(device_pixel_ratio - expected_ratio) > 0.01 ||
+      std::abs(viewport_width * device_pixel_ratio -
+               size.width() * device_scale) > 2 * device_pixel_ratio ||
+      std::abs(viewport_height * device_pixel_ratio -
+               size.height() * device_scale) > 2 * device_pixel_ratio) {
+    VLOG(1) << "NoventraGlass ntp.report rejected_viewport ntp=" << this
+            << " view=" << (view != nullptr) << " size=" << size.ToString()
+            << " count=" << bounds.size() << " css_width=" << viewport_width
+            << " css_height=" << viewport_height
+            << " device_pixel_ratio=" << device_pixel_ratio
+            << " expected_ratio=" << expected_ratio
+            << " device_scale=" << device_scale << " zoom=" << zoom_level;
+    InvalidateNoventraForegroundBounds();
+    return false;
+  }
+  std::vector<gfx::RectF> foreground;
+  for (const auto& rect : bounds) {
+    if (!rect || !std::isfinite(rect->x) || !std::isfinite(rect->y) ||
+        !std::isfinite(rect->width) || !std::isfinite(rect->height) ||
+        rect->x < 0 || rect->y < 0 || rect->width <= 0 || rect->height <= 0 ||
+        rect->x + rect->width > 1.000001 || rect->y + rect->height > 1.000001) {
+      VLOG(1) << "NoventraGlass ntp.report rejected_rect ntp=" << this
+              << " index=" << foreground.size() << " count=" << bounds.size()
+              << " present=" << static_cast<bool>(rect);
+      InvalidateNoventraForegroundBounds();
+      return false;
+    }
+    foreground.emplace_back(rect->x, rect->y, rect->width, rect->height);
+  }
+  if (noventra_foreground_bounds_ == foreground &&
+      noventra_foreground_view_size_ == size &&
+      noventra_foreground_zoom_level_ == zoom_level &&
+      noventra_foreground_device_scale_ == device_scale) {
+    VLOG(1) << "NoventraGlass ntp.report accepted ntp=" << this
+            << " unchanged=1 count=" << foreground.size()
+            << " size=" << size.ToString() << " css_width=" << viewport_width
+            << " css_height=" << viewport_height
+            << " device_scale=" << device_scale << " zoom=" << zoom_level;
+    return true;
+  }
+  noventra_foreground_bounds_ = std::move(foreground);
+  noventra_foreground_view_size_ = size;
+  noventra_foreground_zoom_level_ = zoom_level;
+  noventra_foreground_device_scale_ = device_scale;
+  VLOG(1) << "NoventraGlass ntp.report accepted ntp=" << this
+          << " unchanged=0 count=" << noventra_foreground_bounds_->size()
+          << " size=" << size.ToString() << " css_width=" << viewport_width
+          << " css_height=" << viewport_height
+          << " device_scale=" << device_scale << " zoom=" << zoom_level;
+  ScheduleNoventraGlassUpdate();
+  return true;
+}
+
+void NewTabPageUI::InvalidateNoventraForegroundBounds() {
+  VLOG(1) << "NoventraGlass ntp.invalidate ntp=" << this
+          << " cached=" << noventra_foreground_bounds_.has_value()
+          << " cached_size=" << noventra_foreground_view_size_.ToString();
+  if (noventra_foreground_bounds_) {
+    noventra_foreground_bounds_.reset();
+    ScheduleNoventraGlassUpdate();
+  }
+}
