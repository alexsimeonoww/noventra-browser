+  auto personal = CreateDocumentInPartition(
+      content::StoragePartitionConfig::CreateDefault(browser_context()), url());
+  auto account_a = CreateDocumentInPartition(
+      content::StoragePartitionConfig::Create(
+          browser_context(), "noventra-account-spaces", kNoventraSpaceA, false),
+      url());
+  auto account_b = CreateDocumentInPartition(
+      content::StoragePartitionConfig::Create(
+          browser_context(), "noventra-account-spaces", kNoventraSpaceB, false),
+      url());
+  for (const auto status : {PermissionStatus::ASK, PermissionStatus::GRANTED,
+                            PermissionStatus::DENIED, PermissionStatus::ASK}) {
+    SetPermission(PermissionType::NOTIFICATIONS, status);
+    for (auto* contents : {personal.get(), account_a.get(), account_b.get()}) {
+      auto* frame = contents->GetPrimaryMainFrame();
+      EXPECT_EQ(status, GetPermissionStatusForCurrentDocument(
+                            PermissionType::NOTIFICATIONS, frame));
+      EXPECT_EQ(status,
+                GetPermissionStatusForWorker(PermissionType::NOTIFICATIONS,
+                                             frame->GetProcess(), url()));
+      if (status != PermissionStatus::ASK) {
+        Reset();
+        RequestPermissionFromCurrentDocument(PermissionType::NOTIFICATIONS,
+                                             frame);
+        EXPECT_TRUE(callback_called());
+        EXPECT_EQ(status, callback_result());
+        EXPECT_TRUE(PendingRequestsEmpty());
+      }
+    }
+  }
