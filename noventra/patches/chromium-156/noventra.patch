+  source.SetContentBackgroundColor(SK_ColorBLUE);
+
+  EXPECT_CALL(mock_owner_delegate_, SetBackgroundOpaque(false)).Times(1);
+  view_->SetBackgroundColor(SK_ColorTRANSPARENT);
+  view_->SetContentBackgroundColor(SK_ColorWHITE);
+  testing::Mock::VerifyAndClearExpectations(&mock_owner_delegate_);
+
+  // Both cached content colors are opaque. Copying the default still needs
+  // to restore the renderer's opaque canvas.
+  EXPECT_CALL(mock_owner_delegate_, SetBackgroundOpaque(true)).Times(1);
+  view_->CopyBackgroundColorIfPresentFrom(source);
+  EXPECT_EQ(SK_ColorBLUE, view_->GetBackgroundColor());
+  view_->SetBackgroundColor(SK_ColorBLUE);
+}
