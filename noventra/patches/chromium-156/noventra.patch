index 0000000..cca11ea
--- /dev/null
+++ b/components/helium_onboarding/src/components/NoventraPasswordManagers.svelte
@@ -0,0 +1,134 @@
+<script lang="ts">
+    import { onMount } from 'svelte';
+    import { sendWithPromise } from '../lib/cr';
+    import { installExtension, WebstoreInstallErrorCode, type ExtensionStatus } from '../lib/browser/extensions';
+    import { passwordManagers } from '../lib/password-managers';
+    import { platform } from '../lib/platform';
+
+    let {
+        extensions = $bindable<ExtensionStatus>({}),
+        installing = $bindable(false),
+        refreshExtensions,
+    }: {
+        extensions?: ExtensionStatus;
+        installing?: boolean;
+        refreshExtensions: () => Promise<void>;
+    } = $props();
+
+    const managers = ['bitwarden', 'onePassword', 'icloudPasswords'];
+    let loading = $state(true);
+    let checkFailed = $state(false);
+    let workingId = $state('');
+    let messages = $state<Record<string, string>>({});
+
+    async function refresh() {
+        loading = true;
+        checkFailed = false;
+        try {
+            await refreshExtensions();
+        } catch {
+            checkFailed = true;
+        } finally {
+            loading = false;
+        }
+    }
+
+    async function install(id: string) {
+        const info = passwordManagers[id];
+        if (!info || installing || loading || checkFailed || extensions[info.extensionId] ||
+            (info.platforms && !info.platforms.includes(platform.name))) return;
+
+        installing = true;
+        workingId = info.extensionId;
+        messages[id] = '';
+        try {
+            if (!(info.extensionId in extensions)) {
+                // This opt-in applies only to extension downloads. Service
+                // consent, browser updates and other service settings stay put.
+                await sendWithPromise('setPref', 'extensions.chrome_web_store', true);
+                const prefs = await sendWithPromise<Record<string, unknown>>('getPrefs');
+                if (prefs['extensions.chrome_web_store'] !== true) {
+                    throw new Error('Downloads were not enabled');
+                }
+            }
+            const result = await installExtension(info.extensionId);
+            await refresh();
+            if (extensions[info.extensionId]) {
+                messages[id] = `${info.title} is ready. Open its toolbar icon to sign in or unlock your vault.`;
+            } else if (!result.success && result.code === WebstoreInstallErrorCode.UserCancelled) {
+                messages[id] = 'Installation canceled. Try again, or continue without installing.';
+            } else if (!result.success && (result.code === WebstoreInstallErrorCode.BlockedByPolicy ||
+                       result.code === WebstoreInstallErrorCode.NotPermitted)) {
+                messages[id] = 'Installation isn’t allowed by your browser or organization settings. You can continue without it.';
+            } else {
+                messages[id] = 'The extension wasn’t enabled. Try again, or continue without installing.';
+            }
+        } catch {
+            messages[id] = 'Couldn’t install the extension. Check your connection and Chrome Web Store downloads in Settings, then try again. You can also continue without it.';
+        } finally {
+            installing = false;
+            workingId = '';
+        }
+    }
+
+    onMount(() => {
+        void refresh();
+    });
+</script>
+
+<div class="managers" aria-busy={loading || installing}>
+    {#if checkFailed}
+        <div class="check-error" role="status">We couldn’t check installed extensions.
+            <button id="retry-managers" onclick={refresh} disabled={installing}>Try again</button>
+        </div>
+    {/if}
+    {#each managers as id}
+        {@const info = passwordManagers[id]}
+        {@const supported = !info.platforms || info.platforms.includes(platform.name)}
+        {@const enabled = extensions[info.extensionId] === true}
+        {@const disabled = extensions[info.extensionId] === false}
+        <article class="manager" class:unavailable={!supported} data-manager={id}>
+            <div class="manager-top">
+                <span class="manager-icon" aria-hidden="true">{id === 'bitwarden' ? 'B' : id === 'onePassword' ? '1' : '☁'}</span>
+                <h3>{info.title}</h3>
+                <button id={`install-${id}`} class:installed={enabled} class="install"
+                    disabled={!supported || loading || checkFailed || installing || enabled}
+                    onclick={() => install(id)} aria-label={`${disabled ? 'Enable' : 'Install'} ${info.title}`}>
+                    {workingId === info.extensionId ? 'Installing…' : !supported ? 'Unavailable' :
+                        enabled ? 'Installed ✓' : loading ? 'Checking…' : disabled ? 'Enable' : 'Install'}
+                </button>
+            </div>
+            <p>{id === 'bitwarden' ? 'Keep using your Bitwarden vault in Noventra.' :
+                id === 'onePassword' ? 'Sign in to your 1Password account in the extension.' :
+                supported ? 'Requires macOS Sonoma or later, or iCloud for Windows with Passwords enabled.' :
+                    'iCloud Passwords is available on macOS and Windows. Apple doesn’t offer it for Linux.'}</p>
+            {#if id === 'onePassword'}
+                <a href={info.setupGuide} target="_blank" rel="noopener noreferrer">Connect the desktop app</a>
+            {/if}
+            {#if messages[id]}<p class="manager-message" role="status" aria-live="polite">{messages[id]}</p>{/if}
+        </article>
+    {/each}
+</div>
+<p class="download-note">Install allows Chrome Web Store downloads and updates directly from Google when no extension proxy is enabled. You’ll see the extension’s permission prompt. Change downloads in <a href="chrome://settings/services" target="_blank" rel="noopener noreferrer">Settings → Noventra services</a>.</p>
+<p class="vault-note">Sign in inside your extension. Your vault and master password never pass through setup.</p>
+
+<style>
+    .managers { display:grid;gap:10px; }
+    .manager { border:1px solid var(--line);border-radius:12px;padding:16px;min-width:0; }
+    .manager-top { display:flex;align-items:center;gap:12px;flex-wrap:wrap; }
+    .manager-icon { display:grid;place-items:center;width:34px;height:34px;background:var(--soft);border-radius:9px;font-size:19px;font-weight:650;flex-shrink:0; }
+    h3 { margin:0;font-size:14px;font-weight:600;flex:1; }
+    .managers button { cursor:pointer;font:inherit;min-height:40px;border-radius:8px;border:1px solid var(--line);padding:8px 14px;background:var(--ink);color:var(--surface);font-size:12px; }
+    .managers button:disabled { cursor:default;opacity:.5; }
+    .managers button.installed { background:var(--soft);color:var(--ink);opacity:1; }
+    .managers button:focus-visible,a:focus-visible { outline:2px solid var(--ink);outline-offset:4px; }
+    .manager p { margin:11px 0 0;color:var(--muted);font-size:12px;line-height:1.6;overflow-wrap:anywhere; }
+    .manager a { display:inline-block;font-size:11px;margin-top:8px; }
+    .manager .manager-message { color:var(--ink); }
+    a { color:inherit;text-underline-offset:3px; }
+    .download-note,.vault-note,.check-error { font-size:11px;line-height:1.65;color:var(--muted); }
+    .download-note { margin:18px 0 10px; }.vault-note { margin:0; }
+    .check-error button { margin-left:8px; }
+    .unavailable { background:var(--soft); }
+    @media(max-width:360px) { .manager { padding:12px; }.manager-top { gap:8px; }.install { width:100%; } }
+</style>
