+  features.InitFromCommandLine("NoventraProtectedVideoRgbUpload", "");
+  raster_->set_texture_rg(true);
+  auto* sii = context_provider_->SharedImageInterface();
+  auto caps = sii->GetCapabilities();
+  caps.supports_scanout_shared_images = true;
+  sii->SetCapabilities(caps);
+  auto updater = std::make_unique<VideoResourceUpdater>(
+      context_provider_.get(), resource_provider_.get(),
+      /*shared_image_interface=*/nullptr,
+      /*use_gpu_memory_buffer_resources=*/true,
+      /*max_resource_size=*/10000);
+  auto frame = CreateTestYUVVideoFrame();
+  frame->set_color_space(gfx::ColorSpace::CreateREC709());
+  frame->metadata().protected_video = true;
+  raster_->ResetUploadCount();
