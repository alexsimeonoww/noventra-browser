+  auto resource = updater->CreateExternalResourceFromVideoFrame(frame);
+  ASSERT_EQ(VideoFrameResourceType::RGB, resource.type);
+  EXPECT_TRUE(resource.resource.GetFormat().is_single_plane());
+  EXPECT_EQ(frame->coded_size(), resource.resource.GetSize());
+  EXPECT_FALSE(resource.resource.GetIsOverlayCandidate());
+  EXPECT_EQ(1, raster_->UploadCount());
+  EXPECT_TRUE(frame->metadata().protected_video);
+  EXPECT_FALSE(frame->metadata().hw_protected);
+
+  // Reuse the same frame and preserve software-protected quad classification.
+  updater->ObtainFrameResource(frame);
+  auto pass = viz::CompositorRenderPass::Create();
+  pass->SetNew(viz::CompositorRenderPassId{1}, gfx::Rect(frame->coded_size()),
+               gfx::Rect(), gfx::Transform());
+  updater->AppendQuad(pass.get(), frame, gfx::Transform(),
+                      gfx::Rect(frame->coded_size()),
+                      gfx::Rect(frame->coded_size()), gfx::MaskFilterInfo(),
+                      std::nullopt, /*context_opaque=*/true,
+                      /*draw_opacity=*/1.0, /*sorting_context_id=*/0);
+  ASSERT_EQ(1u, pass->quad_list.size());
+  const auto* quad =
+      pass->quad_list.ElementAt(0)->DynamicCast<viz::TextureDrawQuad>();
+  ASSERT_NE(nullptr, quad);
+  EXPECT_EQ(gfx::ProtectedVideoType::kSoftwareProtected,
+            quad->protected_video_type);
+  EXPECT_EQ(1, raster_->UploadCount());
+  updater->ReleaseFrameResource();
+}
