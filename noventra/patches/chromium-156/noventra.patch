+// Copyright 2026 The Noventra Authors. All rights reserved.
+
+#ifndef CHROME_BROWSER_UI_NOVENTRA_WORKSPACE_ROUTES_H_
+#define CHROME_BROWSER_UI_NOVENTRA_WORKSPACE_ROUTES_H_
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/types/expected.h"
+
+class BrowserWindowInterface;
+class GURL;
+class Profile;
+
+namespace noventra {
+
+inline constexpr char kWorkspaceRoutesPref[] =
+    "noventra.browser.workspace_routes";
+inline constexpr size_t kMaxWorkspaceRoutes = 100;
+
+struct WorkspaceRoute {
+  std::string host;
+  // Personal is the empty ID. Other IDs are lowercase space UUIDs.
+  std::string space_id;
+};
+
+// Accepts a bare DNS/IDN name or IP host, never a URL, port or wildcard. Pure:
+// it can also validate an import before any profile preferences are changed.
+base::expected<std::string, std::string> CanonicalWorkspaceRouteHost(
+    const std::string& host);
+
+// Off-the-record profiles cannot read, edit or apply these routes. Mutations
+// also require the route preference to be user-modifiable.
+bool CanManageWorkspaceRoutes(Profile* profile);
+// Retains valid rules whose targets are missing or archived, so they remain
+// visible and removable. Reading never restores a space or rewrites routes.
+std::vector<WorkspaceRoute> GetWorkspaceRoutes(Profile* profile);
+base::expected<void, std::string> SetWorkspaceRoute(
+    BrowserWindowInterface* browser,
+    const std::string& host,
+    const std::string& space_id);
+base::expected<void, std::string> RemoveWorkspaceRoute(Profile* profile,
+                                                       const std::string& host);
+
+// Exact canonical host match for HTTP(S) only. Missing/archived targets are
+// ignored. nullopt means no match; an engaged empty string means Personal.
+std::optional<std::string> ResolveWorkspaceRoute(
+    BrowserWindowInterface* browser,
+    const GURL& url);
+
+}  // namespace noventra
+
+#endif  // CHROME_BROWSER_UI_NOVENTRA_WORKSPACE_ROUTES_H_
diff --git b/chrome/browser/ui/noventra/workspace_sync_document.cc b/chrome/browser/ui/noventra/workspace_sync_document.cc
new file mode 100644
index 0000000..2e572f9
--- /dev/null
+++ b/chrome/browser/ui/noventra/workspace_sync_document.cc
@@ -0,0 +1,262 @@
+// Copyright 2026 The Noventra Authors. All rights reserved.
+#include "chrome/browser/ui/noventra/workspace_sync_document.h"
+
+#include <algorithm>
+#include <set>
+#include <tuple>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/uuid.h"
+
+namespace noventra {
+namespace {
+constexpr char kInvalidDocument[] = "invalid_workspace_document";
+
+base::DictValue PortableLayout(const BrowserLayout& input) {
+  auto layout = input;
+  layout.revision = 0;
+  std::ranges::sort(layout.items, [](const auto& a, const auto& b) {
+    return std::tie(a.edge, a.order, a.id) < std::tie(b.edge, b.order, b.id);
+  });
+  return LayoutToValue(layout);
+}
+}  // namespace
+
+bool IsWorkspaceSyncUuid(std::string_view value) {
+  const auto uuid = base::Uuid::ParseLowercase(value);
+  return uuid.is_valid() && uuid.AsLowercaseString() == value;
+}
+
+base::DictValue WorkspaceSyncDocumentToValue(
+    const WorkspaceSyncDocument& document) {
+  base::ListValue spaces;
+  for (const auto& space : document.spaces) {
+    spaces.Append(base::DictValue()
+                      .Set("id", space.id)
+                      .Set("name", space.name)
+                      .Set("archived", space.archived));
+  }
+  return base::DictValue()
+      .Set("format", "noventra-workspace-sync")
+      .Set("version", 1)
+      .Set("spaces", std::move(spaces))
+      .Set("layout", PortableLayout(document.layout));
+}
+
+base::expected<WorkspaceSyncDocument, std::string> ParseWorkspaceSyncDocument(
+    std::string_view bytes,
+    base::span<const LayoutCapability> capabilities) {
+  if (bytes.size() > kWorkspaceSyncMaximumDocumentBytes) {
+    return base::unexpected(kInvalidDocument);
+  }
+  auto value = base::JSONReader::ReadDict(bytes, base::JSON_PARSE_RFC);
+  if (!value) {
+    return base::unexpected(kInvalidDocument);
+  }
+  auto document = ValidateWorkspaceSyncDocument(*value, capabilities);
+  // The browser emits one canonical representation. Exact round-trip rejects
+  // duplicate JSON keys and alternate encodings that JSONReader normalizes.
+  if (!document.has_value()) {
+    return document;
+  }
+  if (SerializeWorkspaceSyncDocument(*document) != bytes) {
+    return base::unexpected(kInvalidDocument);
+  }
+  return document;
+}
+
+base::expected<WorkspaceSyncDocument, std::string>
+ValidateWorkspaceSyncDocument(const base::DictValue& value,
+                              base::span<const LayoutCapability> capabilities) {
+  const auto* format = value.FindString("format");
+  const auto* spaces = value.FindList("spaces");
+  const auto* layout = value.FindDict("layout");
+  if (value.size() != 4 || !format || *format != "noventra-workspace-sync" ||
+      value.FindInt("version") != 1 || !spaces || spaces->empty() ||
+      spaces->size() > kWorkspaceSyncMaximumSpaces || !layout ||
+      layout->size() != 3 || layout->FindInt("revision") != 0) {
+    return base::unexpected(kInvalidDocument);
+  }
+  WorkspaceSyncDocument result;
+  std::set<std::string> ids;
+  for (const auto& entry : *spaces) {
+    const auto* space = entry.GetIfDict();
+    const auto* id = space ? space->FindString("id") : nullptr;
+    const auto* name = space ? space->FindString("name") : nullptr;
+    const auto archived = space ? space->FindBool("archived") : std::nullopt;
+    std::string trimmed;
+    if (name) {
+      base::TrimWhitespaceASCII(*name, base::TRIM_ALL, &trimmed);
+    }
+    if (!space || space->size() != 3 || !id || !name || !archived ||
+        (*id != kWorkspaceSyncPersonalId && !IsWorkspaceSyncUuid(*id)) ||
+        !ids.insert(*id).second || name->empty() || name->size() > 160 ||
+        trimmed != *name || !base::IsStringUTF8(*name) ||
+        std::ranges::any_of(
+            *name, [](unsigned char c) { return c < 0x20 || c == 0x7f; }) ||
+        (*id == kWorkspaceSyncPersonalId && *archived)) {
+      return base::unexpected(kInvalidDocument);
+    }
+    result.spaces.push_back({*id, *name, *archived});
+  }
+  if (!ids.contains(kWorkspaceSyncPersonalId)) {
+    return base::unexpected(kInvalidDocument);
+  }
+  const auto* items = layout->FindList("items");
+  if (!items || std::ranges::any_of(*items, [](const base::Value& item) {
+        return !item.is_dict() || item.GetDict().size() != 4;
+      })) {
+    return base::unexpected(kInvalidDocument);
+  }
+  auto checked = ValidateLayout(base::Value(layout->Clone()), capabilities);
+  if (!checked.has_value()) {
+    return base::unexpected("unsupported_workspace_layout");
+  }
+  for (const auto& capability : capabilities) {
+    if (capability.managed) {
+      return base::unexpected("workspace_settings_managed");
+    }
+    if (capability.required_visibility) {
+      auto item =
+          std::ranges::find(checked->items, capability.id, &LayoutItem::id);
+      if (item == checked->items.end() ||
+          item->visible != *capability.required_visibility) {
+        return base::unexpected("workspace_settings_managed");
+      }
+    }
+  }
+  result.layout = std::move(*checked);
+  return result;
+}
+
+std::string SerializeWorkspaceSyncDocument(
+    const WorkspaceSyncDocument& document) {
+  return base::WriteJson(WorkspaceSyncDocumentToValue(document)).value_or("");
+}
+
+bool WorkspaceSyncDocumentsEqual(const WorkspaceSyncDocument& a,
+                                 const WorkspaceSyncDocument& b) {
+  return a.spaces == b.spaces && WorkspaceSyncLayoutsEqual(a.layout, b.layout);
+}
+
+bool WorkspaceSyncLayoutsEqual(const BrowserLayout& a, const BrowserLayout& b) {
+  return PortableLayout(a) == PortableLayout(b);
+}
+
+base::expected<WorkspaceSyncMapping, std::string> ParseWorkspaceSyncMapping(
+    const base::DictValue& value) {
+  const auto* personal = value.FindString(kWorkspaceSyncPersonalId);
+  if (!personal || !personal->empty() ||
+      value.size() > kWorkspaceSyncMaximumLocalSpaces) {
+    return base::unexpected("invalid_workspace_mapping");
+  }
+  WorkspaceSyncMapping result;
+  std::set<std::string> locals;
+  for (const auto [logical, local] : value) {
+    if (!local.is_string() ||
+        (logical != kWorkspaceSyncPersonalId &&
+         (!IsWorkspaceSyncUuid(logical) ||
+          !IsWorkspaceSyncUuid(local.GetString()))) ||
+        !locals.insert(local.GetString()).second) {
+      return base::unexpected("invalid_workspace_mapping");
+    }
+    result.emplace(logical, local.GetString());
+  }
+  return result;
+}
+
+base::DictValue WorkspaceSyncMappingToValue(
+    const WorkspaceSyncMapping& mapping) {
+  base::DictValue result;
+  for (const auto& [logical, local] : mapping) {
+    result.Set(logical, local);
+  }
+  return result;
+}
+
+base::expected<void, std::string> ValidateWorkspaceSyncIdentityCapacity(
+    const WorkspaceSyncMapping& mapping,
+    const std::set<std::string>& excluded) {
+  const auto personal = mapping.find(kWorkspaceSyncPersonalId);
+  if (personal == mapping.end() || !personal->second.empty()) {
+    return base::unexpected("invalid_workspace_mapping");
+  }
+  if (mapping.size() > kWorkspaceSyncMaximumLocalSpaces ||
+      excluded.size() > kWorkspaceSyncMaximumRetainedLocalIds ||
+      mapping.size() - 1 >
+          kWorkspaceSyncMaximumRetainedLocalIds - excluded.size()) {
+    return base::unexpected("too_many_local_workspaces");
+  }
+  for (const auto& [logical, local] : mapping) {
+    if (excluded.contains(local)) {
+      return base::unexpected("invalid_workspace_mapping");
+    }
+  }
+  return base::ok();
+}
+
+base::expected<void, std::string> ValidateWorkspaceSyncApplyCapacity(
+    const WorkspaceSyncMapping& mapping,
+    const std::set<std::string>& excluded,
+    base::span<const WorkspaceSyncSpace> observed_local,
+    base::span<const WorkspaceSyncSpace> desired) {
+  auto capacity = ValidateWorkspaceSyncIdentityCapacity(mapping, excluded);
+  if (!capacity.has_value()) {
+    return capacity;
+  }
+  std::set<std::string> locals;
+  for (const auto& space : observed_local) {
+    locals.insert(space.id);
+  }
+  for (const auto& [logical, local] : mapping) {
+    locals.insert(local);
+  }
+  const size_t additions = std::ranges::count_if(
+      desired, [&](const auto& space) { return !mapping.contains(space.id); });
+  if (additions > kWorkspaceSyncMaximumLocalSpaces - mapping.size() ||
+      additions > kWorkspaceSyncMaximumRetainedLocalIds - excluded.size() -
+                      (mapping.size() - 1) ||
+      locals.size() > kWorkspaceSyncMaximumLocalSpaces ||
+      additions > kWorkspaceSyncMaximumLocalSpaces - locals.size()) {
+    return base::unexpected("too_many_local_workspaces");
+  }
+  return base::ok();
+}
+
+void DetachWorkspaceSyncMappings(
+    const std::set<std::string>& retained_logical_ids,
+    WorkspaceSyncMapping& mapping,
+    std::set<std::string>& excluded) {
+  for (auto it = mapping.begin(); it != mapping.end();) {
+    if (it->first != kWorkspaceSyncPersonalId &&
+        !retained_logical_ids.contains(it->first)) {
+      excluded.insert(it->second);
+      it = mapping.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+WorkspaceSyncDecision CompareWorkspaceSyncDocuments(
+    const WorkspaceSyncDocument& local,
+    const WorkspaceSyncDocument& remote,
+    const WorkspaceSyncDocument* common) {
+  if (WorkspaceSyncDocumentsEqual(local, remote)) {
+    // Equality with an edit that has not reached the common state still needs
+    // the durable apply intent and preference barrier before accepting it.
+    return common && WorkspaceSyncDocumentsEqual(remote, *common)
+               ? WorkspaceSyncDecision::kEqual
+               : WorkspaceSyncDecision::kApply;
+  }
+  if (!common || WorkspaceSyncDocumentsEqual(local, *common)) {
+    return WorkspaceSyncDecision::kApply;
+  }
+  if (WorkspaceSyncDocumentsEqual(remote, *common)) {
+    return WorkspaceSyncDecision::kUpload;
+  }
+  return WorkspaceSyncDecision::kConflict;
+}
+}  // namespace noventra
diff --git b/chrome/browser/ui/noventra/workspace_sync_document.h b/chrome/browser/ui/noventra/workspace_sync_document.h
new file mode 100644
index 0000000..3590e82
--- /dev/null
+++ b/chrome/browser/ui/noventra/workspace_sync_document.h
@@ -0,0 +1,94 @@
+// Copyright 2026 The Noventra Authors. All rights reserved.
+#ifndef CHROME_BROWSER_UI_NOVENTRA_WORKSPACE_SYNC_DOCUMENT_H_
+#define CHROME_BROWSER_UI_NOVENTRA_WORKSPACE_SYNC_DOCUMENT_H_
+
+#include <map>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+#include "chrome/browser/ui/noventra/layout_model.h"
+
+namespace noventra {
+
+inline constexpr char kWorkspaceSyncPersonalId[] = "personal";
+inline constexpr size_t kWorkspaceSyncMaximumSpaces = 256;
+inline constexpr size_t kWorkspaceSyncMaximumLocalSpaces = 1024;
+// Each non-Personal mapping reserves a future permanent exclusion slot.
+inline constexpr size_t kWorkspaceSyncMaximumRetainedLocalIds = 1024;
+inline constexpr size_t kWorkspaceSyncMaximumDocumentBytes = 1024 * 1024;
+
+struct WorkspaceSyncSpace {
+  // Logical UUID in a remote document; local partition UUID in a UI snapshot.
+  // Personal is "personal" remotely and the empty ID locally.
+  std::string id;
+  std::string name;
+  bool archived = false;
+  bool operator==(const WorkspaceSyncSpace&) const = default;
+};
+
+struct WorkspaceSyncDocument {
+  // The list is the order. Revision is always zero on the wire.
+  std::vector<WorkspaceSyncSpace> spaces;
+  BrowserLayout layout;
+};
+
+using WorkspaceSyncMapping = std::map<std::string, std::string>;
+
+bool IsWorkspaceSyncUuid(std::string_view value);
+base::DictValue WorkspaceSyncDocumentToValue(
+    const WorkspaceSyncDocument& document);
+base::expected<WorkspaceSyncDocument, std::string> ParseWorkspaceSyncDocument(
+    std::string_view bytes,
+    base::span<const LayoutCapability> capabilities);
+base::expected<WorkspaceSyncDocument, std::string>
+ValidateWorkspaceSyncDocument(const base::DictValue& value,
+                              base::span<const LayoutCapability> capabilities);
+std::string SerializeWorkspaceSyncDocument(
+    const WorkspaceSyncDocument& document);
+bool WorkspaceSyncDocumentsEqual(const WorkspaceSyncDocument& a,
+                                 const WorkspaceSyncDocument& b);
+bool WorkspaceSyncLayoutsEqual(const BrowserLayout& a, const BrowserLayout& b);
+
+// Rejects non-bijective or partition-changing maps. Personal is reserved.
+base::expected<WorkspaceSyncMapping, std::string> ParseWorkspaceSyncMapping(
+    const base::DictValue& value);
+base::DictValue WorkspaceSyncMappingToValue(
+    const WorkspaceSyncMapping& mapping);
+
+// Given a structurally validated mapping/exclusion set, admit only identities
+// that can all be detached later without exceeding persistent exclusion limits.
+// Personal is checked before subtraction and consumes no exclusion slot.
+base::expected<void, std::string> ValidateWorkspaceSyncIdentityCapacity(
+    const WorkspaceSyncMapping& mapping,
+    const std::set<std::string>& excluded);
+// Preflight all incoming logical IDs together, counting dormant exclusions,
+// old mappings that will detach, and the existing observed-space bound.
+base::expected<void, std::string> ValidateWorkspaceSyncApplyCapacity(
+    const WorkspaceSyncMapping& mapping,
+    const std::set<std::string>& excluded,
+    base::span<const WorkspaceSyncSpace> observed_local,
+    base::span<const WorkspaceSyncSpace> desired);
+// Transfer reservations to permanent exclusions after the durable apply
+// barrier. This cannot grow the admitted identity footprint and never prunes
+// exclusions.
+void DetachWorkspaceSyncMappings(
+    const std::set<std::string>& retained_logical_ids,
+    WorkspaceSyncMapping& mapping,
+    std::set<std::string>& excluded);
+
+// kEqual is the durable fast path: local, remote and common all agree. Equal
+// new edits still select kApply so the preference barrier precedes new common.
+enum class WorkspaceSyncDecision { kEqual, kUpload, kApply, kConflict };
+// An absent common state is joining, not permission to overwrite the remote.
+WorkspaceSyncDecision CompareWorkspaceSyncDocuments(
+    const WorkspaceSyncDocument& local,
+    const WorkspaceSyncDocument& remote,
+    const WorkspaceSyncDocument* common);
+
+}  // namespace noventra
+#endif  // CHROME_BROWSER_UI_NOVENTRA_WORKSPACE_SYNC_DOCUMENT_H_
diff --git b/chrome/browser/ui/noventra/workspace_sync_document_unittest.cc b/chrome/browser/ui/noventra/workspace_sync_document_unittest.cc
new file mode 100644
index 0000000..7f756e0
--- /dev/null
+++ b/chrome/browser/ui/noventra/workspace_sync_document_unittest.cc
@@ -0,0 +1,403 @@
+// Copyright 2026 The Noventra Authors. All rights reserved.
+#include "chrome/browser/ui/noventra/workspace_sync_document.h"
+
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/noventra/workspace_sync_service.h"
+#include "components/sync/engine/cancelation_signal.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace noventra {
+class WorkspaceSyncServiceTestPeer {
+ public:
+  static void Cancel(syncer::CancelationSignal& signal) {
+    WorkspaceSyncService::SignalCancelationOnce(signal);
+  }
+};
+
+namespace {
+constexpr char kLogical[] = "c65f6051-1089-4518-9eb1-8fb140a9bb59";
+constexpr char kOtherLogical[] = "2ab41560-f328-482b-a360-7876c93ad84a";
+constexpr char kLocal[] = "ff3c3769-053b-4d1f-a193-a908ddc98809";
+
+std::vector<LayoutCapability> Capabilities() {
+  return {{"tabs", "Tabs", {DockEdge::kTop, DockEdge::kLeft}, false},
+          {"spaces", "Spaces", {DockEdge::kLeft, DockEdge::kRight}, true}};
+}
+WorkspaceSyncDocument Document() {
+  WorkspaceSyncDocument document;
+  document.spaces = {{kWorkspaceSyncPersonalId, "Personal", false},
+                     {kLogical, "Work", false}};
+  document.layout.items = {{"tabs", DockEdge::kTop, 0, true},
+                           {"spaces", DockEdge::kLeft, 0, true}};
+  return document;
+}
+
+std::string CapacityUuid(size_t index) {
+  const auto suffix = base::NumberToString(index);
+  return "00000000-0000-4000-8000-" + std::string(12 - suffix.size(), '0') +
+         suffix;
+}
+
+std::set<std::string> ExcludedSpaces(size_t count) {
+  std::set<std::string> excluded;
+  for (size_t i = 1; i <= count; ++i) {
+    excluded.insert(CapacityUuid(i));
+  }
+  return excluded;
+}
+
+std::vector<WorkspaceSyncSpace> ObservedSpaces(
+    const std::set<std::string>& excluded) {
+  std::vector<WorkspaceSyncSpace> observed{{"", "Personal", false}};
+  for (const auto& id : excluded) {
+    observed.push_back({id, "Local account", false});
+  }
+  return observed;
+}
+
+TEST(WorkspaceSyncDocumentTest,
+     RoundTripKeepsOrderAndNeverSharesLocalRevision) {
+  auto original = Document();
+  original.layout.revision = 487;
+  original.spaces[1].archived = true;
+  std::swap(original.spaces[0], original.spaces[1]);
+  const auto serialized = SerializeWorkspaceSyncDocument(original);
+  auto parsed = ParseWorkspaceSyncDocument(serialized, Capabilities());
+  ASSERT_TRUE(parsed.has_value());
+  EXPECT_EQ(parsed->layout.revision, 0);
+  EXPECT_EQ(parsed->spaces, original.spaces);
+  EXPECT_TRUE(WorkspaceSyncDocumentsEqual(*parsed, original));
+}
+
+TEST(WorkspaceSyncDocumentTest, PersonalIsRequiredAndCannotBeArchived) {
+  auto document = Document();
+  document.spaces[0].archived = true;
+  EXPECT_FALSE(ParseWorkspaceSyncDocument(
+                   SerializeWorkspaceSyncDocument(document), Capabilities())
+                   .has_value());
+  document.spaces.erase(document.spaces.begin());
+  EXPECT_FALSE(ParseWorkspaceSyncDocument(
+                   SerializeWorkspaceSyncDocument(document), Capabilities())
+                   .has_value());
+}
+
+TEST(WorkspaceSyncDocumentTest, RejectsDuplicateIdentityAndMalformedNames) {
+  auto document = Document();
+  document.spaces.push_back(document.spaces.back());
+  EXPECT_FALSE(ParseWorkspaceSyncDocument(
+                   SerializeWorkspaceSyncDocument(document), Capabilities())
+                   .has_value());
+  for (const auto& name : {"", " leading", "trailing ", "line\nbreak"}) {
+    document = Document();
+    document.spaces[1].name = name;
+    EXPECT_FALSE(ParseWorkspaceSyncDocument(
+                     SerializeWorkspaceSyncDocument(document), Capabilities())
+                     .has_value());
+  }
+  document = Document();
+  document.spaces[1].name = std::string(161, 'a');
+  EXPECT_FALSE(ParseWorkspaceSyncDocument(
+                   SerializeWorkspaceSyncDocument(document), Capabilities())
+                   .has_value());
+}
+
+TEST(WorkspaceSyncDocumentTest, RejectsDuplicateJsonKeysAndNonScopeFields) {
+  auto bytes = SerializeWorkspaceSyncDocument(Document());
+  bytes.insert(1, "\"version\":1,");
