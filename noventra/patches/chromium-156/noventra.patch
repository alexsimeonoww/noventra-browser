+  SkPath GetFrameMaterialCutout(const views::View* frame) const;
+  bool HasSidebarLibrary() const;
+  bool ContainsPoint(const gfx::Point& point) const;
+  bool IsVisibleCaptionPoint(const gfx::Point& point) const;
