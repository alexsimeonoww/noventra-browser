+  ScopedWebstoreQueryDelegate query_delegate;
+  const GURL destination(
+      "https://clients2.google.com/service/update2/"
+      "crx?prodversion=old&custom=a%26b");
+  const std::string factory_params =
+      UpdateQueryParams::Get(UpdateQueryParams::CRX_DUMMY) + "&testrequest=1";
+  ManifestFetchData fetch(destination, 0, "", factory_params,
+                          ManifestFetchData::NO_PING,
+                          DownloadFetchPriority::kBackground);
+  for (const char* id : {kTestExtensionId, kTestExtensionId2}) {
+    ASSERT_TRUE(fetch.AddExtension(id, "1.0", nullptr, "", "",
+                                   mojom::ManifestLocation::kInternal,
+                                   DownloadFetchPriority::kBackground));
+  }
+  const GURL original = fetch.full_url();
+  fetch.RemoveExtensions({}, factory_params);
+  EXPECT_EQ(original, fetch.full_url());
+  fetch.RemoveExtensions({kTestExtensionId}, factory_params);
+  EXPECT_EQ(ExtensionIdSet({kTestExtensionId2}), fetch.GetExtensionIds());
+  EXPECT_TRUE(base::StartsWith(fetch.full_url().GetQuery(),
+                               UpdateQueryParams::Get(UpdateQueryParams::CRX) +
+                                   "&custom=a%26b&testrequest=1&x="));
+  std::string extension_query;
+  ASSERT_TRUE(
+      net::GetValueForKeyInQuery(fetch.full_url(), "x", &extension_query));
+  EXPECT_TRUE(base::StartsWith(extension_query, "id=test_app2&v=1.0&"));
