+  source.SetBackgroundColor(SK_ColorTRANSPARENT);
+  source.SetContentBackgroundColor(kTint);
+
+  // A hidden glass tab is made opaque, but retains its last rendered tint.
+  view_->SetBackgroundColor(SK_ColorWHITE);
+  view_->SetContentBackgroundColor(kTint);
