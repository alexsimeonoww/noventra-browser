+  source.SetContentBackgroundColor(SK_ColorWHITE);
+
+  EXPECT_CALL(mock_owner_delegate_, SetBackgroundOpaque(false)).Times(1);
+  view_->SetBackgroundColor(SK_ColorTRANSPARENT);
+  view_->SetContentBackgroundColor(SkColorSetARGB(176, 28, 28, 28));
+  testing::Mock::VerifyAndClearExpectations(&mock_owner_delegate_);
+
+  // Page content changes the visual fallback, not the canvas opacity override.
