+    std::unique_ptr<views::MenuItemView> root;
+    if (folder) {
+      delegate_.SetActiveMenu(*folder, 0);
+      root = base::WrapUnique(delegate_.menu());
+    } else {
+      root = std::make_unique<views::MenuItemView>(this);
+      root->CreateSubmenu();
