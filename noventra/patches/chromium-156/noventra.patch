diff --git b/components/noventra_sync_vault/BUILD.gn b/components/noventra_sync_vault/BUILD.gn
new file mode 100644
index 0000000..79d32ca
--- /dev/null
+++ b/components/noventra_sync_vault/BUILD.gn
@@ -0,0 +1,49 @@
+# Copyright 2026 The Helium Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import("//testing/test.gni")
+import("//third_party/protobuf/proto_library.gni")
+
+proto_library("sync_vault_proto") {
+  proto_in_dir = "//"
+  sources = [ "sync_vault.proto" ]
+  extra_configs = [ "//build/config/compiler:wexit_time_destructors" ]
+}
+
+source_set("sync_vault") {
+  sources = [
+    "sync_vault_cryptographer.cc",
+    "sync_vault_cryptographer.h",
+    "sync_vault_format.cc",
+    "sync_vault_format.h",
+    "sync_vault_limits.h",
+    "sync_vault_state_codec.h",
+    "sync_vault_store.cc",
+    "sync_vault_store.h",
+    "sync_vault_transport.h",
+  ]
+
+  public_deps = [
+    "//base",
+    "//crypto",
+  ]
+
+  deps = [ ":sync_vault_proto" ]
+}
+
+# Runnable in isolation, without linking the Chromium browser test suites.
+test("sync_vault_store_unittests") {
+  sources = [
+    "sync_vault_compatibility_unittest.cc",
+    "sync_vault_store_unittest.cc",
+  ]
+  deps = [
+    ":sync_vault",
+    "//base",
+    "//base/test:run_all_unittests",
+    "//base/test:test_support",
+    "//crypto",
+    "//testing/gtest",
+  ]
+}
diff --git b/components/noventra_sync_vault/README.md b/components/noventra_sync_vault/README.md
new file mode 100644
index 0000000..8d1f4c2
--- /dev/null
+++ b/components/noventra_sync_vault/README.md
@@ -0,0 +1,25 @@
+# Noventra workspace vault compatibility
+
+This module retains the encrypted workspace settings format used by Noventra's
+Chromium154 builds. It is independent of Chromium156's rewritten Helium sync
+vault, whose descriptor/journal API and serialized messages changed. Existing
+workspace vaults, checkpoints, cancellation and bounded incremental reads retain
+their previous behavior. File export and direct device transfer use their own
+existing formats.
+
+The initial implementation comes from the preserved Noventra154 source based on
+Helium b38c4bdd2ecbe5c680dc3c5d464a2edc84d49d4c, including the existing incremental
+reader and its regression tests. Imported license and copyright notices remain.
+The compatibility port changes include paths, guards, C++/protobuf namespaces and
+the generated protobuf root. Protobuf field numbers, encryption context, object
+roles, limits, transport revisions and checkpoint validation remain unchanged.
+
+`noventra_sync_pb` prevents generated symbol collisions with the upstream vault;
+its package name does not change these serialized protobuf messages. The shared
+sync engine cancellation signal remains a `syncer::CancelationSignal`.
+
+Build and run `//components/noventra_sync_vault:sync_vault_store_unittests` with the
+matched Chromium toolchain. Keep the cursor, corruption, cancellation, ancestry,
+changed-head and checkpoint regression checks when updating this component.
+Any future format migration must authenticate the existing vault and preserve a
+recoverable checkpoint before writing a replacement.
diff --git b/components/noventra_sync_vault/sync_vault.proto b/components/noventra_sync_vault/sync_vault.proto
new file mode 100644
index 0000000..52573c6
--- /dev/null
+++ b/components/noventra_sync_vault/sync_vault.proto
@@ -0,0 +1,51 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+syntax = "proto2";
+
+option optimize_for = LITE_RUNTIME;
+
+package noventra_sync_pb;
+
+// Encrypted vault metadata. Cryptographic authentication is provided
+// by the enclosing AEAD.
+message SyncVaultDescriptor {
+  optional uint32 format_version = 1;
+  optional string vault_uuid = 2;
+  optional int64 creation_time_millis = 3;
+}
+
+message SyncVaultHead {
+  optional uint32 format_version = 1;
+  optional uint64 generation = 2;
+  optional string record_id = 3;
+  optional uint32 epoch = 4;
+  optional uint64 epoch_start_generation = 5;
+  optional uint32 minimum_retained_epoch = 6;
+  optional uint64 minimum_retained_generation = 7;
+  optional uint64 epoch_uploaded_bytes = 8;
+}
+
+message SyncVaultObjectReference {
+  optional string object_id = 1;
+  optional uint32 plaintext_size = 2;
+}
+
+message SyncVaultJournalRecord {
+  optional uint32 format_version = 1;
+  optional uint64 generation = 2;
+  optional int64 creation_time_millis = 3;
+  optional uint32 mutation_count = 4;
+  optional string parent_record_id = 5;
+  repeated SyncVaultObjectReference state_chunks = 6;
+  optional uint32 epoch = 7;
+}
+
+message SyncVaultCheckpoint {
+  optional uint32 format_version = 1;
+  optional string vault_uuid = 2;
+  optional uint64 generation = 3;
+  optional string record_id = 4;
+  optional uint32 epoch = 5;
+}
diff --git b/components/noventra_sync_vault/sync_vault_compatibility_unittest.cc b/components/noventra_sync_vault/sync_vault_compatibility_unittest.cc
