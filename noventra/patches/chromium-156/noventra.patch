+TEST_F(RenderWidgetHostTest, BackgroundCopyRestoresRendererOpacity) {
+  auto source_host = MockRenderWidgetHost::Create(
+      nullptr, delegate_.get(), site_instance_group_->GetSafeRef(),
+      process_->GetNextRoutingID());
