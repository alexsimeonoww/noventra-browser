+           "https://clients2.google.com/service/update2/crx",
+           "https://proxy.example.test/ext",
+           "https://clients2.google.com/service/update2/crx",
+           "https://noventra-services-are-disabled.qjz9zk",
+           "https://example.test/update.xml",
+       }) {
+    SCOPED_TRACE(spec);
+    const GURL destination(spec);
+    ASSERT_TRUE(helper.downloader().AddPendingExtension(
+        CreateDownloaderTask(kTestExtensionId, destination)));
+    helper.downloader().StartAllPending(nullptr);
+    auto* pending = helper.GetPendingRequest();
+    ASSERT_TRUE(pending);
+    const GURL request_url = pending->request.url;
+    if (extension_urls::IsDirectWebstoreUpdateUrl(destination)) {
+      EXPECT_TRUE(
+          base::StartsWith(request_url.GetQuery(),
+                           UpdateQueryParams::Get(UpdateQueryParams::CRX) +
+                               "&testrequest=1&x="));
+      EXPECT_EQ(network::mojom::CredentialsMode::kOmit,
+                pending->request.credentials_mode);
+    } else {
+      EXPECT_TRUE(
+          base::StartsWith(request_url.GetQuery(), factory_params + "&x="));
+    }
+    helper.test_url_loader_factory().SimulateResponseForPendingRequest(
+        request_url.spec(), "", net::HTTP_NOT_FOUND);
+    content::RunAllTasksUntilIdle();
+    EXPECT_EQ(0, helper.test_url_loader_factory().NumPending());
+  }
+}
