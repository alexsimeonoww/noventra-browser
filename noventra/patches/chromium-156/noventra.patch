+enum class SyncVaultStoreError {
+  kAuthenticationRequired,
+  kConflict,
+  kNetworkError,
+  kTemporaryError,
+  kQuotaExceeded,
+  kAccessDenied,
+  kInvalidData,
+  kUnsupported,
