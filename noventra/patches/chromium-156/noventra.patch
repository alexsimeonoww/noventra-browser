index 0000000..816438e
--- /dev/null
+++ b/chrome/browser/ui/noventra/portable_passwords.h
@@ -0,0 +1,116 @@
+// Copyright 2026 The Noventra Authors. All rights reserved.
+#ifndef CHROME_BROWSER_UI_NOVENTRA_PORTABLE_PASSWORDS_H_
+#define CHROME_BROWSER_UI_NOVENTRA_PORTABLE_PASSWORDS_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/timer/timer.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "components/password_manager/core/browser/import/csv_password.h"
+#include "components/password_manager/services/csv_password/public/mojom/csv_password_parser.mojom.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+class Profile;
+namespace content {
+class WebContents;
+}
+namespace device_reauth {
+class DeviceAuthenticator;
+}
+namespace password_manager {
+struct ImportResults;
+class PasswordImporter;
+class PasswordStoreInterface;
+class SavedPasswordsPresenter;
+}  // namespace password_manager
+
+namespace noventra {
+
+// UI-sequence helper owned by the transfer WebUI. Password plaintext stays in
+// native memory: ExportCSV is for the native encrypted-bundle caller only.
+//
+// Only one operation/review can be active. PrepareImport parses in Chromium's
+// sandboxed CSV service and does not write. CommitImport refreshes the stores,
+// then uses the native importer, keeping every existing login and its notes.
+// Notes, passkeys, blocked and federated credentials are not transferred.
+//
+// Cancel drops uncommitted data and pending callbacks. A commit already handed
+// to a password store cannot be rolled back by destroying/canceling the helper.
+// The owner must cancel/destroy on WebUI unload. Profile shutdown also cancels.
+class PortablePasswords final : public ProfileObserver {
+ public:
+  using ExportResult = base::expected<std::string, std::string>;
+  using ExportCallback = base::OnceCallback<void(ExportResult)>;
+  using Result = base::expected<base::DictValue, std::string>;
+  using Callback = base::OnceCallback<void(Result)>;
+
+  explicit PortablePasswords(Profile* profile);
+  PortablePasswords(const PortablePasswords&) = delete;
+  PortablePasswords& operator=(const PortablePasswords&) = delete;
+  ~PortablePasswords() override;
+
+  static bool IsAvailable(Profile* profile);
+
+  // Matches the native password-manager export gate: fresh authentication on
+  // Mac/Windows/ChromeOS. The pinned Linux native exporter has no OS prompt.
+  // Call only after an explicit user transfer/export request.
+  void ExportCSV(content::WebContents* contents, ExportCallback callback);
+
+  // Count-only review keys: passwords, new_passwords, kept_passwords.
+  // Malformed/oversized/invalid credential data rejects the entire preparation.
+  void PrepareImport(std::string csv, Callback callback);
+
+  // Count-only outcome keys: imported, kept, failed. "imported" follows the
+  // native importer's processed-success count; concurrent identical additions
+  // can be counted as already present. No selected replacement IDs are used.
+  void CommitImport(Callback callback);
+  void Cancel();
+
+ private:
+  enum class State { kIdle, kExporting, kPreparing, kPrepared, kCommitting };
+
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+  void OnAuthenticated(base::WeakPtr<content::WebContents> contents,
+                       bool authenticated);
+  void StartPresenter();
+  void OnPresenterReady();
+  void OnCSVParsed(password_manager::mojom::CSVPasswordSequencePtr sequence);
+  void PrepareAgainstCurrentStore();
+  void OnImportPrepared(const password_manager::ImportResults& result);
+  void OnImportCommitted(const password_manager::ImportResults& result);
+  void Fail(std::string message);
+  void FinishExport(ExportResult result);
+  void FinishImport(Result result);
+  bool StoresAvailable() const;
+
+  raw_ptr<Profile> profile_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  State state_ = State::kIdle;
+  ExportCallback export_callback_;
+  Callback callback_;
+  std::unique_ptr<device_reauth::DeviceAuthenticator> authenticator_;
+  scoped_refptr<password_manager::PasswordStoreInterface> profile_store_;
+  scoped_refptr<password_manager::PasswordStoreInterface> account_store_;
+  std::unique_ptr<password_manager::SavedPasswordsPresenter> presenter_;
+  std::unique_ptr<password_manager::PasswordImporter> importer_;
+  mojo::Remote<password_manager::mojom::CSVPasswordParser> parser_;
+  std::vector<password_manager::CSVPassword> incoming_;
+  size_t passwords_count_ = 0;
+  size_t kept_count_ = 0;
+  size_t prepared_count_ = 0;
+  base::OneShotTimer operation_timer_;
+  base::WeakPtrFactory<PortablePasswords> weak_factory_{this};
+};
+
+}  // namespace noventra
+
+#endif  // CHROME_BROWSER_UI_NOVENTRA_PORTABLE_PASSWORDS_H_
diff --git b/chrome/browser/ui/noventra/portable_transfer_codec.cc b/chrome/browser/ui/noventra/portable_transfer_codec.cc
new file mode 100644
index 0000000..9d45f7d
--- /dev/null
+++ b/chrome/browser/ui/noventra/portable_transfer_codec.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The Noventra Authors. All rights reserved.
+
+#include "chrome/browser/ui/noventra/portable_transfer_codec.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_view_util.h"
+#include "base/threading/thread_restrictions.h"
+#include "crypto/aead.h"
+#include "crypto/kdf.h"
+#include "crypto/random.h"
+#include "crypto/secure_util.h"
+#include "crypto/subtle_passkey.h"
+
+namespace noventra {
+namespace {
+
+// The identifiers select one fixed v1 combination, not arbitrary parameters:
+// version 1, scrypt preset 1, AES-256-GCM-SIV, reserved flags 0.
+constexpr auto kHeader =
+    std::to_array<uint8_t>({'N', 'o', 'v', 'e', 'n', 't', 'r', 'a', 'T', 'r',
+                            'a', 'n', 's', 'f', 'e', 'r', 1,   1,   1,   0});
+constexpr size_t kSaltBytes = 16;
+constexpr size_t kNonceBytes = 12;
+constexpr size_t kKeyBytes = 32;
+constexpr size_t kTagBytes = 16;
+constexpr size_t kSaltOffset = kHeader.size();
+constexpr size_t kNonceOffset = kSaltOffset + kSaltBytes;
+constexpr size_t kCiphertextOffset = kNonceOffset + kNonceBytes;
+constexpr auto kAlgorithm = crypto::aead::AES_256_GCM_SIV;
+
+static_assert(kCiphertextOffset + kTagBytes ==
+              PortableTransferCodec::kEnvelopeOverheadBytes);
+
+// N=2^17, r=8, p=1 requires 128 MiB plus small implementation overhead.
+// The 256 MiB cap leaves room for that overhead without permitting the envelope
+// to request a higher cost. These constants are part of the version-1 format.
+constexpr crypto::kdf::ScryptParams kScryptParams{
+    .cost = 1 << 17,
+    .block_size = 8,
+    .parallelization = 1,
+    .max_memory_bytes = 256 * 1024 * 1024};
+
+constexpr char kPasswordError[] = "Use a password between 12 and 1,024 bytes.";
+constexpr char kFormatError[] =
+    "This is not a supported Noventra transfer file.";
+constexpr char kAuthenticationError[] =
+    "The password is incorrect or the transfer file is damaged.";
+constexpr char kSizeError[] = "The transfer is larger than the 32 MB limit.";
+
+bool IsPasswordLengthAllowed(std::string_view password) {
+  return password.size() >= PortableTransferCodec::kMinimumPasswordBytes &&
+         password.size() <= PortableTransferCodec::kMaximumPasswordBytes;
+}
+
+}  // namespace
+
+// static
+PortableTransferCodec::SealResult PortableTransferCodec::Seal(
+    std::string_view plaintext,
+    std::string_view password) {
+  if (!IsPasswordLengthAllowed(password)) {
+    return base::unexpected(kPasswordError);
+  }
+  if (plaintext.size() > kMaximumPlaintextBytes) {
+    return base::unexpected(kSizeError);
+  }
+  base::AssertLongCPUWorkAllowed();
+
+  std::array<uint8_t, kCiphertextOffset> prefix;
+  std::copy(kHeader.begin(), kHeader.end(), prefix.begin());
+  crypto::RandBytes(base::span(prefix).subspan(kSaltOffset, kSaltBytes));
+  crypto::RandBytes(base::span(prefix).subspan(kNonceOffset, kNonceBytes));
+  std::array<uint8_t, kKeyBytes> key;
+  DeriveKey(password, base::span(prefix).subspan(kSaltOffset, kSaltBytes), key);
+  auto ciphertext = crypto::aead::Seal(
+      kAlgorithm, key, base::as_byte_span(plaintext),
+      base::span(prefix).subspan(kNonceOffset, kNonceBytes), prefix);
+  crypto::SecureZeroBuffer(key);
+  if (ciphertext.size() != plaintext.size() + kTagBytes) {
+    return base::unexpected("The transfer could not be encrypted.");
+  }
+
+  std::vector<uint8_t> envelope;
+  envelope.reserve(prefix.size() + ciphertext.size());
+  envelope.insert(envelope.end(), prefix.begin(), prefix.end());
+  envelope.insert(envelope.end(), ciphertext.begin(), ciphertext.end());
+  return envelope;
+}
+
+// static
+PortableTransferCodec::OpenResult PortableTransferCodec::Open(
+    base::span<const uint8_t> envelope,
+    std::string_view password) {
+  if (!IsPasswordLengthAllowed(password)) {
+    return base::unexpected(kPasswordError);
+  }
+  if (envelope.size() > kMaximumEnvelopeBytes) {
+    return base::unexpected(kSizeError);
+  }
+  if (envelope.size() < kEnvelopeOverheadBytes ||
+      !std::ranges::equal(envelope.first(kHeader.size()), kHeader)) {
+    return base::unexpected(kFormatError);
+  }
+  base::AssertLongCPUWorkAllowed();
+
+  std::array<uint8_t, kKeyBytes> key;
+  DeriveKey(password, envelope.subspan(kSaltOffset, kSaltBytes), key);
+  auto plaintext =
+      crypto::aead::Open(kAlgorithm, key, envelope.subspan(kCiphertextOffset),
+                         envelope.subspan(kNonceOffset, kNonceBytes),
+                         envelope.first(kCiphertextOffset));
+  crypto::SecureZeroBuffer(key);
+  if (!plaintext) {
+    return base::unexpected(kAuthenticationError);
+  }
+  std::string result(base::as_string_view(*plaintext));
+  crypto::SecureZeroBuffer(*plaintext);
+  return base::ok(std::move(result));
+}
+
+// static
+void PortableTransferCodec::DeriveKey(std::string_view password,
+                                      base::span<const uint8_t> salt,
+                                      base::span<uint8_t> key) {
+  crypto::kdf::Scrypt(kScryptParams, base::as_byte_span(password), salt, key,
+                      crypto::SubtlePassKey());
+}
+
+}  // namespace noventra
diff --git b/chrome/browser/ui/noventra/portable_transfer_codec.h b/chrome/browser/ui/noventra/portable_transfer_codec.h
new file mode 100644
index 0000000..1711828
--- /dev/null
+++ b/chrome/browser/ui/noventra/portable_transfer_codec.h
@@ -0,0 +1,58 @@
+// Copyright 2026 The Noventra Authors. All rights reserved.
+
+#ifndef CHROME_BROWSER_UI_NOVENTRA_PORTABLE_TRANSFER_CODEC_H_
+#define CHROME_BROWSER_UI_NOVENTRA_PORTABLE_TRANSFER_CODEC_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/types/expected.h"
+
+namespace noventra {
+
+// An authenticated, password-protected transfer envelope. This module performs
+// no file I/O and does not parse or apply the decrypted browser document.
+//
+// Call on a long-CPU-work-allowed worker sequence, with at most one operation
+// per transfer controller. The fixed scrypt preset uses about 128 MiB of
+// working memory. Never call synchronously from a browser/UI or network
+// sequence. Passwords are byte strings: the UI may enforce a stronger character
+// policy, but must preserve the exact UTF-8 bytes (including whitespace) on
+// both sides. The caller owns and must clear its password and plaintext buffers
+// when done.
+class PortableTransferCodec final {
+ public:
+  PortableTransferCodec() = delete;
+
+  static constexpr size_t kMinimumPasswordBytes = 12;
+  static constexpr size_t kMaximumPasswordBytes = 1024;
+  static constexpr size_t kMaximumPlaintextBytes = 32 * 1024 * 1024;
+  static constexpr size_t kEnvelopeOverheadBytes = 64;
+  static constexpr size_t kMaximumEnvelopeBytes =
+      kMaximumPlaintextBytes + kEnvelopeOverheadBytes;
+
+  using SealResult = base::expected<std::vector<uint8_t>, std::string>;
+  using OpenResult = base::expected<std::string, std::string>;
+
+  // Version 1 consists of a 20-byte fixed format/version/KDF/algorithm header,
+  // a 16-byte salt, a 12-byte nonce, ciphertext and a 16-byte authentication
+  // tag. The whole 48-byte prefix is authenticated. Unsupported or oversized
+  // inputs are rejected before deriving a key; input bytes cannot choose KDF
+  // costs.
+  static SealResult Seal(std::string_view plaintext, std::string_view password);
+  static OpenResult Open(base::span<const uint8_t> envelope,
+                         std::string_view password);
+
+ private:
+  static void DeriveKey(std::string_view password,
+                        base::span<const uint8_t> salt,
+                        base::span<uint8_t> key);
+};
+
+}  // namespace noventra
+
+#endif  // CHROME_BROWSER_UI_NOVENTRA_PORTABLE_TRANSFER_CODEC_H_
diff --git b/chrome/browser/ui/noventra/portable_transfer_codec_unittest.cc b/chrome/browser/ui/noventra/portable_transfer_codec_unittest.cc
new file mode 100644
index 0000000..44ff7e4
--- /dev/null
+++ b/chrome/browser/ui/noventra/portable_transfer_codec_unittest.cc
@@ -0,0 +1,160 @@
+// Copyright 2026 The Noventra Authors. All rights reserved.
+
+#include "chrome/browser/ui/noventra/portable_transfer_codec.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace noventra {
+namespace {
+
+constexpr std::string_view kPassword = "fixture-transfer-password";
+constexpr std::string_view kDocument =
+    R"({"format":"noventra-portable-data","version":1,"title":"Fixture"})";
+
+TEST(PortableTransferCodecTest, RoundTripPreservesExactBinaryPlaintext) {
+  const std::string document("a\0b\xff", 4);
+  auto sealed = PortableTransferCodec::Seal(document, kPassword);
+  ASSERT_TRUE(sealed.has_value());
+  EXPECT_EQ(sealed->size(),
+            document.size() + PortableTransferCodec::kEnvelopeOverheadBytes);
+  auto opened = PortableTransferCodec::Open(*sealed, kPassword);
+  ASSERT_TRUE(opened.has_value());
+  EXPECT_EQ(*opened, document);
+}
+
+TEST(PortableTransferCodecTest, EmptyPlaintextStillHasAnAuthenticationTag) {
+  auto sealed = PortableTransferCodec::Seal("", kPassword);
+  ASSERT_TRUE(sealed.has_value());
+  EXPECT_EQ(sealed->size(), PortableTransferCodec::kEnvelopeOverheadBytes);
+  auto opened = PortableTransferCodec::Open(*sealed, kPassword);
+  ASSERT_TRUE(opened.has_value());
+  EXPECT_TRUE(opened->empty());
+}
+
+TEST(PortableTransferCodecTest, SaltAndNonceChangeForEveryEnvelope) {
+  auto first = PortableTransferCodec::Seal(kDocument, kPassword);
+  auto second = PortableTransferCodec::Seal(kDocument, kPassword);
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(second.has_value());
+  EXPECT_FALSE(std::ranges::equal(base::span(*first).subspan<20, 16>(),
+                                  base::span(*second).subspan<20, 16>()));
+  EXPECT_FALSE(std::ranges::equal(base::span(*first).subspan<36, 12>(),
+                                  base::span(*second).subspan<36, 12>()));
+  EXPECT_NE(*first, *second);
+  EXPECT_EQ(std::search(first->begin(), first->end(), kDocument.begin(),
+                        kDocument.end()),
+            first->end());
+}
+
+TEST(PortableTransferCodecTest, WrongPasswordAndCiphertextDamageReleaseNoData) {
+  auto sealed = PortableTransferCodec::Seal(kDocument, kPassword);
+  ASSERT_TRUE(sealed.has_value());
+  auto wrong_password =
+      PortableTransferCodec::Open(*sealed, "incorrect-fixture-password");
+  ASSERT_FALSE(wrong_password.has_value());
+
+  sealed->back() ^= 1;
+  auto damaged = PortableTransferCodec::Open(*sealed, kPassword);
+  ASSERT_FALSE(damaged.has_value());
+  EXPECT_EQ(wrong_password.error(), damaged.error());
+}
+
+TEST(PortableTransferCodecTest, SaltNonceCiphertextAndTagAreAuthenticated) {
+  auto sealed = PortableTransferCodec::Seal(kDocument, kPassword);
+  ASSERT_TRUE(sealed.has_value());
+  for (const size_t offset :
+       {size_t{20}, size_t{36}, size_t{48}, sealed->size() - 1}) {
+    SCOPED_TRACE(offset);
+    auto changed = *sealed;
+    changed[offset] ^= 1;
+    EXPECT_FALSE(PortableTransferCodec::Open(changed, kPassword).has_value());
+  }
+}
+
+TEST(PortableTransferCodecTest, RejectsUnknownHeaderVersionKdfAndAlgorithm) {
+  auto sealed = PortableTransferCodec::Seal(kDocument, kPassword);
+  ASSERT_TRUE(sealed.has_value());
+  // Fixed header positions include magic, version, preset, algorithm and flags.
+  // Every such change is rejected before selecting or invoking a KDF.
+  for (size_t offset = 0; offset < 20; ++offset) {
+    SCOPED_TRACE(offset);
+    auto changed = *sealed;
+    changed[offset] ^= 1;
+    EXPECT_FALSE(PortableTransferCodec::Open(changed, kPassword).has_value());
+  }
+}
+
+TEST(PortableTransferCodecTest, RejectsTruncatedOrAppendedCiphertext) {
+  auto sealed = PortableTransferCodec::Seal(kDocument, kPassword);
+  ASSERT_TRUE(sealed.has_value());
+  for (size_t length = 0;
+       length < PortableTransferCodec::kEnvelopeOverheadBytes; ++length) {
+    SCOPED_TRACE(length);
+    EXPECT_FALSE(PortableTransferCodec::Open(base::span(*sealed).first(length),
+                                             kPassword)
+                     .has_value());
+  }
+  auto truncated = *sealed;
+  truncated.pop_back();
+  EXPECT_FALSE(PortableTransferCodec::Open(truncated, kPassword).has_value());
+  auto appended = *sealed;
+  appended.push_back(0);
+  EXPECT_FALSE(PortableTransferCodec::Open(appended, kPassword).has_value());
+}
+
+TEST(PortableTransferCodecTest, RejectsPasswordLengthsOutsideBounds) {
+  for (const auto& password :
+       {std::string(),
+        std::string(PortableTransferCodec::kMinimumPasswordBytes - 1, 'p'),
+        std::string(PortableTransferCodec::kMaximumPasswordBytes + 1, 'p')}) {
+    EXPECT_FALSE(PortableTransferCodec::Seal(kDocument, password).has_value());
+    const std::vector<uint8_t> envelope(
+        PortableTransferCodec::kEnvelopeOverheadBytes, 0);
+    EXPECT_FALSE(PortableTransferCodec::Open(envelope, password).has_value());
+  }
+}
+
+TEST(PortableTransferCodecTest, AcceptsExactPasswordLengthBounds) {
+  for (const size_t length : {PortableTransferCodec::kMinimumPasswordBytes,
+                              PortableTransferCodec::kMaximumPasswordBytes}) {
+    SCOPED_TRACE(length);
+    const std::string password(length, 'p');
+    auto sealed = PortableTransferCodec::Seal(kDocument, password);
+    ASSERT_TRUE(sealed.has_value());
+    auto opened = PortableTransferCodec::Open(*sealed, password);
+    ASSERT_TRUE(opened.has_value());
+    EXPECT_EQ(*opened, kDocument);
+  }
+}
+
+TEST(PortableTransferCodecTest, PasswordBytesAreNotTrimmedOrNullTerminated) {
+  const std::string password(" password\0with spaces ", 22);
+  auto sealed = PortableTransferCodec::Seal(kDocument, password);
+  ASSERT_TRUE(sealed.has_value());
+  auto opened = PortableTransferCodec::Open(*sealed, password);
+  ASSERT_TRUE(opened.has_value());
+  EXPECT_EQ(*opened, kDocument);
+  EXPECT_FALSE(PortableTransferCodec::Open(*sealed, " password").has_value());
+  EXPECT_FALSE(
+      PortableTransferCodec::Open(*sealed, "password with spaces").has_value());
+}
+
+TEST(PortableTransferCodecTest, RejectsOversizedInputsBeforeCryptoWork) {
+  const std::string document(PortableTransferCodec::kMaximumPlaintextBytes + 1,
+                             'x');
+  EXPECT_FALSE(PortableTransferCodec::Seal(document, kPassword).has_value());
+  const std::vector<uint8_t> envelope(
+      PortableTransferCodec::kMaximumEnvelopeBytes + 1, 0);
+  EXPECT_FALSE(PortableTransferCodec::Open(envelope, kPassword).has_value());
+}
+
+}  // namespace
+}  // namespace noventra
diff --git b/chrome/browser/ui/noventra/workspace_routes.cc b/chrome/browser/ui/noventra/workspace_routes.cc
new file mode 100644
index 0000000..acbc4f6
--- /dev/null
+++ b/chrome/browser/ui/noventra/workspace_routes.cc
@@ -0,0 +1,206 @@
+// Copyright 2026 The Noventra Authors. All rights reserved.
+
+#include "chrome/browser/ui/noventra/workspace_routes.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+#include "base/strings/string_util.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/noventra_commands.h"
+#include "components/prefs/pref_service.h"
+#include "url/gurl.h"
+
+namespace noventra {
+namespace {
+
+bool HasWorkspaceRoutes(Profile* profile) {
+  return profile && !profile->IsOffTheRecord() &&
+         profile->GetPrefs()->FindPreference(kWorkspaceRoutesPref);
+}
+
+void SaveWorkspaceRoutes(Profile* profile,
+                         const std::vector<WorkspaceRoute>& routes) {
+  base::ListValue value;
+  for (const auto& route : routes) {
+    base::DictValue entry;
+    entry.Set("host", route.host);
+    entry.Set("space_id", route.space_id);
+    value.Append(std::move(entry));
+  }
+  profile->GetPrefs()->SetList(kWorkspaceRoutesPref, std::move(value));
+}
+
+}  // namespace
+
+base::expected<std::string, std::string> CanonicalWorkspaceRouteHost(
+    const std::string& host) {
+  std::string input;
+  base::TrimWhitespaceASCII(host, base::TRIM_ALL, &input);
+  constexpr char kInvalidHost[] =
+      "Enter a hostname such as example.com, without a URL, port or wildcard.";
+  if (input.empty() || input.size() > 2048 || !base::IsStringUTF8(input) ||
+      input.find_first_of("/@?#\\%*") != std::string::npos ||
+      (input.front() == '[' ? !input.ends_with(']')
+                            : input.find(':') != std::string::npos) ||
+      std::ranges::any_of(
+          input, [](unsigned char c) { return c <= 0x20 || c == 0x7f; })) {
+    return base::unexpected(kInvalidHost);
+  }
+  // GURL supplies the same IDN, case and IP canonicalization as navigation.
+  const GURL url("https://" + input + "/");
+  if (!url.is_valid() || !url.has_host() || url.has_username() ||
+      url.has_password() || url.has_port() || url.path() != "/" ||
+      url.has_query() || url.has_ref()) {
+    return base::unexpected(kInvalidHost);
+  }
+  std::string canonical(url.host());
+  if (url.HostIsIPAddress()) {
+    return base::ok(std::move(canonical));
+  }
+  if (canonical.ends_with('.')) {
+    canonical.pop_back();
+  }
+  if (canonical.empty() || canonical.size() > 253) {
+    return base::unexpected(kInvalidHost);
+  }
+  // GURL also accepts some non-DNS hosts. Reject empty, oversized or malformed
+  // labels so saved rules are literal hostnames, not permissive URL syntax.
+  std::string_view remaining(canonical);
+  while (!remaining.empty()) {
+    const size_t dot = remaining.find('.');
+    const auto label = remaining.substr(0, dot);
+    if (label.empty() || label.size() > 63 || label.front() == '-' ||
+        label.back() == '-' || !std::ranges::all_of(label, [](char c) {
+          return base::IsAsciiAlphaNumeric(c) || c == '-';
+        })) {
+      return base::unexpected(kInvalidHost);
+    }
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    remaining.remove_prefix(dot + 1);
+    if (remaining.empty()) {
+      return base::unexpected(kInvalidHost);
+    }
+  }
+  return base::ok(std::move(canonical));
+}
+
+bool CanManageWorkspaceRoutes(Profile* profile) {
+  return HasWorkspaceRoutes(profile) && !profile->ShutdownStarted() &&
+         profile->GetPrefs()
+             ->FindPreference(kWorkspaceRoutesPref)
+             ->IsUserModifiable();
+}
+
+std::vector<WorkspaceRoute> GetWorkspaceRoutes(Profile* profile) {
+  std::vector<WorkspaceRoute> routes;
+  if (!HasWorkspaceRoutes(profile)) {
+    return routes;
+  }
+  for (const auto& value : profile->GetPrefs()->GetList(kWorkspaceRoutesPref)) {
+    const auto* entry = value.GetIfDict();
+    const auto* host = entry ? entry->FindString("host") : nullptr;
+    const auto* id = entry ? entry->FindString("space_id") : nullptr;
+    if (!host || !id ||
+        (!id->empty() && !base::Uuid::ParseLowercase(*id).is_valid())) {
+      continue;
+    }
+    auto canonical = CanonicalWorkspaceRouteHost(*host);
+    if (!canonical.has_value() ||
+        std::ranges::find(routes, *canonical, &WorkspaceRoute::host) !=
+            routes.end()) {
+      continue;
+    }
+    routes.push_back({std::move(*canonical), *id});
+    if (routes.size() == kMaxWorkspaceRoutes) {
+      break;
+    }
+  }
+  return routes;
+}
+
+base::expected<void, std::string> SetWorkspaceRoute(
+    BrowserWindowInterface* browser,
+    const std::string& host,
+    const std::string& space_id) {
+  if (!browser || !CanManageWorkspaceRoutes(browser->GetProfile())) {
+    return base::unexpected(
+        "Workspace routing cannot be changed in this profile.");
+  }
+  auto canonical = CanonicalWorkspaceRouteHost(host);
+  if (!canonical.has_value()) {
+    return base::unexpected(canonical.error());
+  }
+  const auto ids = SpaceIds(browser);
+  if (std::ranges::find(ids, space_id) == ids.end() ||
+      IsSpaceArchived(browser->GetProfile(), space_id)) {
+    return base::unexpected("Choose an existing, non-archived space.");
+  }
+  auto routes = GetWorkspaceRoutes(browser->GetProfile());
+  auto existing = std::ranges::find(routes, *canonical, &WorkspaceRoute::host);
+  if (existing != routes.end()) {
+    existing->space_id = space_id;
+  } else {
+    if (routes.size() >= kMaxWorkspaceRoutes) {
+      return base::unexpected(
+          "Remove a route before adding more than 100 hosts.");
+    }
+    routes.push_back({std::move(*canonical), space_id});
+  }
+  SaveWorkspaceRoutes(browser->GetProfile(), routes);
+  return base::ok();
+}
+
+base::expected<void, std::string> RemoveWorkspaceRoute(
+    Profile* profile,
+    const std::string& host) {
+  if (!CanManageWorkspaceRoutes(profile)) {
+    return base::unexpected(
+        "Workspace routing cannot be changed in this profile.");
+  }
+  auto canonical = CanonicalWorkspaceRouteHost(host);
+  if (!canonical.has_value()) {
+    return base::unexpected(canonical.error());
+  }
+  auto routes = GetWorkspaceRoutes(profile);
+  if (!std::erase_if(routes, [&](const WorkspaceRoute& route) {
+        return route.host == *canonical;
+      })) {
+    return base::unexpected("This workspace route no longer exists.");
+  }
+  SaveWorkspaceRoutes(profile, routes);
+  return base::ok();
+}
+
+std::optional<std::string> ResolveWorkspaceRoute(
+    BrowserWindowInterface* browser,
+    const GURL& url) {
+  if (!browser || !HasWorkspaceRoutes(browser->GetProfile()) ||
+      !url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  auto canonical = CanonicalWorkspaceRouteHost(std::string(url.host()));
+  if (!canonical.has_value()) {
+    return std::nullopt;
+  }
+  const auto routes = GetWorkspaceRoutes(browser->GetProfile());
+  const auto route =
+      std::ranges::find(routes, *canonical, &WorkspaceRoute::host);
+  if (route == routes.end() ||
+      IsSpaceArchived(browser->GetProfile(), route->space_id)) {
+    return std::nullopt;
+  }
+  const auto ids = SpaceIds(browser);
+  if (std::ranges::find(ids, route->space_id) == ids.end()) {
+    return std::nullopt;
+  }
+  return route->space_id;
+}
+
+}  // namespace noventra
