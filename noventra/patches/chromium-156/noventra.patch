+  const double minimum = std::min(64.0 / usable, pair / 2.0);
+  pane_weights_[boundary] = std::clamp(initial[boundary] + amount / usable, minimum, pair - minimum);
+  pane_weights_[boundary + 1] = pair - pane_weights_[boundary];
