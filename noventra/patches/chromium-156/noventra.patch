+  view_->CopyBackgroundColorIfPresentFrom(source);
+  EXPECT_EQ(kTint, view_->GetBackgroundColor());
+
+  // Reattaching the tab repeats this request. The copy must already have
+  // restored the renderer because the default color now makes this a no-op.
+  view_->SetBackgroundColor(SK_ColorTRANSPARENT);
+  view_->CopyBackgroundColorIfPresentFrom(source);
+}
