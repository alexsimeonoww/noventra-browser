+      composition_available && ShouldUseNativeFrame() && !IsFullscreen() &&
+      CanResize() && CanMaximize() && (style & WS_THICKFRAME) &&
+      (style & WS_MAXIMIZEBOX) && !(ex_style & WS_EX_LAYERED);
