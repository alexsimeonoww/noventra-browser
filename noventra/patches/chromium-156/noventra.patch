+
+  bool IsCommandIdEnabled(int command_id) const override {
+    if (!IsAvailable(source_)) {
+      return false;
+    }
+    if (command_id == kSplitWithNewTabCommand) {
+      return !source_->IsSplit();
+    }
+    const int candidate = command_id - kFirstSplitCandidateCommand;
+    return candidate >= 0 &&
