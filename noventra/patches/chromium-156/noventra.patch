+
+  override render() {
+    return getHtml.call(this);
+  }
+
+  static override get properties() {
+    return {
+      busy_: {type: Boolean}, available_: {type: Boolean}, error_: {type: String},
+      status_: {type: String}, categories_: {type: Object}, password_: {type: String},
