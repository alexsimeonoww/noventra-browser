+// Keep the one-time width upgrade across all windows in the initial restore.
+// SessionRestore's completion callback runs after every window is constructed;
+// removing this profile-owned state then preserves later per-window choices.
+class SidebarWidthMigration : public base::SupportsUserData::Data {
+ public:
+  static constexpr char kKey[] = "noventra-sidebar-width-migration";
+
+  SidebarWidthMigration(Profile* profile, int previous_width, int width)
+      : previous_width_(previous_width), width_(width) {
+    restore_subscription_ =
+        SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+            [](Profile* owner, Profile* restored, int) {
+              if (owner == restored) {
+                owner->RemoveUserData(kKey);
+              }
+            },
+            base::Unretained(profile)));
+  }
+
+  int width() const { return width_; }
+  bool ShouldMigrate(int restored_width) const {
+    return restored_width == previous_width_ ||
+           (width_ > previous_width_ && restored_width < width_);
+  }
+
+ private:
+  const int previous_width_;
+  const int width_;
+  base::CallbackListSubscription restore_subscription_;
+};
