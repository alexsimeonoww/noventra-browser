+          browser_context(), "noventra-account-spaces", kNoventraSpaceA, false),
+      url());
+  auto* frame = contents->GetPrimaryMainFrame();
+  ASSERT_EQ(PermissionStatus::ASK, GetPermissionStatusForCurrentDocument(
+                                       PermissionType::NOTIFICATIONS, frame));
+  PermissionRequestManager::CreateForWebContents(contents.get());
+  auto* manager = PermissionRequestManager::FromWebContents(contents.get());
+  MockPermissionPromptFactory prompt_factory(manager);
+  prompt_factory.set_response_type(PermissionRequestManager::ACCEPT_ALL);
+  prompt_factory.DocumentOnLoadCompletedInPrimaryMainFrame();
+
+  RequestPermissionFromCurrentDocument(PermissionType::NOTIFICATIONS, frame);
+
+  EXPECT_TRUE(prompt_factory.RequestOriginSeen(url()));
+  EXPECT_EQ(1, prompt_factory.show_count());
+  EXPECT_EQ(PermissionStatus::GRANTED, callback_result());
+  EXPECT_EQ(PermissionStatus::GRANTED,
+            GetPermissionStatusForWorker(PermissionType::NOTIFICATIONS,
+                                         frame->GetProcess(), url()));
+  CheckPermissionStatus(PermissionType::NOTIFICATIONS,
+                        PermissionStatus::GRANTED);
+}
+#endif
+
+TEST_F(PermissionManagerTest,
+       NoventraAccountNotificationsStillRejectInsecureOrigins) {
+  const GURL insecure_origin("http://insecure.example");
+  auto contents = CreateDocumentInPartition(
+      content::StoragePartitionConfig::Create(
+          browser_context(), "noventra-account-spaces", kNoventraSpaceA, false),
+      insecure_origin);
+  SetPermission(insecure_origin, PermissionType::NOTIFICATIONS,
+                PermissionStatus::GRANTED);
+  auto* frame = contents->GetPrimaryMainFrame();
+  const auto result = GetPermissionResultForCurrentDocument(
+      PermissionType::NOTIFICATIONS, frame);
+  EXPECT_EQ(PermissionStatus::DENIED, result.status);
+  EXPECT_EQ(content::PermissionStatusSource::INSECURE_ORIGIN, result.source);
+  EXPECT_EQ(PermissionStatus::DENIED,
+            GetPermissionStatusForWorker(PermissionType::NOTIFICATIONS,
+                                         frame->GetProcess(), insecure_origin));
+  RequestPermissionFromCurrentDocument(PermissionType::NOTIFICATIONS, frame);
+  EXPECT_EQ(PermissionStatus::DENIED, callback_result());
+}
+
+TEST_F(PermissionManagerTest,
+       NoventraAccountNotificationsPreserveEmbeddingChecks) {
+  const auto config = content::StoragePartitionConfig::Create(
+      browser_context(), "noventra-account-spaces", kNoventraSpaceA, false);
+  auto contents = CreateDocumentInPartition(config, url());
+  auto* child = AddChildRFH(contents->GetPrimaryMainFrame(), other_url());
+  ASSERT_EQ(config, child->GetProcess()->GetStoragePartition()->GetConfig());
+  SetPermission(PermissionType::NOTIFICATIONS, PermissionStatus::GRANTED);
+  SetPermission(other_url(), PermissionType::NOTIFICATIONS,
+                PermissionStatus::DENIED);
+  // The top-level grant must not override the requesting origin's denial.
+  EXPECT_EQ(PermissionStatus::DENIED,
+            GetPermissionStatusForCurrentDocument(PermissionType::NOTIFICATIONS,
+                                                  child));
+  RequestPermissionFromCurrentDocument(PermissionType::NOTIFICATIONS, child);
+  EXPECT_EQ(PermissionStatus::DENIED, callback_result());
+
+  auto insecure_embedder = CreateDocumentInPartition(
+      config, GURL("http://insecure-embedder.example"));
+  auto* secure_child =
+      AddChildRFH(insecure_embedder->GetPrimaryMainFrame(), other_url());
+  SetPermission(other_url(), PermissionType::NOTIFICATIONS,
+                PermissionStatus::GRANTED);
+  const auto result = GetPermissionResultForCurrentDocument(
+      PermissionType::NOTIFICATIONS, secure_child);
+  EXPECT_EQ(PermissionStatus::DENIED, result.status);
+  EXPECT_EQ(content::PermissionStatusSource::INSECURE_ORIGIN, result.source);
+}
+
+TEST_F(PermissionManagerTest,
+       NoventraAccountNotificationsRejectNoncanonicalPartitionsAndGuests) {
+  SetPermission(PermissionType::NOTIFICATIONS, PermissionStatus::GRANTED);
+  struct TestCase {
+    const char* domain;
+    const char* name;
+    bool in_memory = false;
+    bool guest = false;
+    bool blob_fallback = false;
+  };
+  const TestCase cases[] = {
+      {"another-isolated-partition", kNoventraSpaceA},
+      {"noventra-account-spaces-extra", kNoventraSpaceA},
+      {"noventra-account-spaces", ""},
+      {"noventra-account-spaces", "not-a-uuid"},
+      {"noventra-account-spaces", "AAAAAAAA-AAAA-4AAA-8AAA-AAAAAAAAAAAA"},
+      {"noventra-account-spaces", kNoventraSpaceA, true},
+      {"noventra-account-spaces", kNoventraSpaceA, false, true},
+      {"noventra-account-spaces", kNoventraSpaceA, false, false, true}};
+  for (const auto& test : cases) {
+    auto config = content::StoragePartitionConfig::Create(
+        browser_context(), test.domain, test.name, test.in_memory);
+    if (test.blob_fallback) {
+      config.set_fallback_to_partition_domain_for_blob_urls(
+          content::StoragePartitionConfig::FallbackMode::
+              kFallbackPartitionOnDisk);
+    }
+    SCOPED_TRACE(testing::Message() << config << " guest=" << test.guest);
+    PartitionPermissionProcess process(browser_context(), config, test.guest);
+    EXPECT_EQ(PermissionStatus::DENIED,
+              GetPermissionStatusForWorker(PermissionType::NOTIFICATIONS,
+                                           &process, url()));
+  }
+}
+
+TEST_F(PermissionManagerTest,
+       NoventraAccountNotificationsRequireMatchingOTRStorageIdentity) {
+  const auto disk_config = content::StoragePartitionConfig::Create(
+      browser_context(), "noventra-account-spaces", kNoventraSpaceA, false);
+  browser_context()->set_is_off_the_record(true);
+  const auto memory_config = content::StoragePartitionConfig::Create(
+      browser_context(), "noventra-account-spaces", kNoventraSpaceA, true);
+  PartitionPermissionProcess disk_process(browser_context(), disk_config);
+  PartitionPermissionProcess memory_process(browser_context(), memory_config);
+  // A matching OTR partition reaches the permission context; this test's base
+  // context does not implement Chrome's additional incognito prompt denial.
+  for (const auto status : {PermissionStatus::ASK, PermissionStatus::DENIED}) {
+    SetPermission(PermissionType::NOTIFICATIONS, status);
+    EXPECT_EQ(status,
+              GetPermissionStatusForWorker(PermissionType::NOTIFICATIONS,
+                                           &memory_process, url()));
+    EXPECT_EQ(PermissionStatus::DENIED,
+              GetPermissionStatusForWorker(PermissionType::NOTIFICATIONS,
+                                           &disk_process, url()));
+  }
+}
+
+TEST_F(PermissionManagerTest,
+       NoventraAccountNotificationsCannotUseAnotherIsolatedOriginsGrant) {
+  ScopedPartitionedOriginBrowserClient browser_client(url());
+  SetPermission(PermissionType::NOTIFICATIONS, PermissionStatus::GRANTED);
+  const auto config = content::StoragePartitionConfig::Create(
+      browser_context(), "noventra-account-spaces", kNoventraSpaceA, false);
+  PartitionPermissionProcess process(browser_context(), config);
+  EXPECT_EQ(PermissionStatus::DENIED,
+            GetPermissionStatusForWorker(PermissionType::NOTIFICATIONS,
+                                         &process, url()));
+}
