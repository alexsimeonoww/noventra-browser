+       DirectManifestUsesNormalParamsAndRetainsExtras) {
+  ScopedWebstoreQueryDelegate query_delegate;
+  const GURL destination(
+      "https://clients2.google.com/service/update2/crx?"
+      "prodversion=0.0.0.0&os=win&%70rodversion=1.0&custom=first%26value&"
+      "custom=second&testrequest=1");
+  const std::string factory_params =
+      UpdateQueryParams::Get(UpdateQueryParams::CRX_DUMMY) +
+      "&prodversion=2.0&prodchannel=old&lang=old&acceptformat=old&"
+      "custom=third%3Dvalue&custom=&testrequest=2";
+  ManifestFetchData fetch(destination, 0, "", factory_params,
+                          ManifestFetchData::NO_PING,
+                          DownloadFetchPriority::kBackground);
+  // Chrome's normal CRX delegate supplies the real browser version, channel
+  // and language. Old fields from either query must not shadow that set.
+  EXPECT_EQ(UpdateQueryParams::Get(UpdateQueryParams::CRX) +
+                "&custom=first%26value&custom=second&testrequest=1&"
+                "custom=third%3Dvalue&custom=&testrequest=2",
+            fetch.full_url().GetQuery());
+  const std::map<std::string, std::string> expected_params = {
+      {"os", std::string(UpdateQueryParams::GetOS())},
+      {"arch", std::string(UpdateQueryParams::GetArch())},
+      {"prod", UpdateQueryParams::GetProdIdString(UpdateQueryParams::CRX)},
+      {"prodchannel", "stable"},
+      {"prodversion", UpdateQueryParams::GetProdVersion()},
+      {"lang", "en-US"},
+      {"acceptformat", "crx3,puff"},
+  };
+  for (const auto& [key, expected_value] : expected_params) {
+    int count = 0;
+    for (net::QueryIterator it(fetch.full_url()); !it.IsAtEnd(); it.Advance()) {
+      if (it.GetKey() == key) {
+        ++count;
+        EXPECT_EQ(expected_value, it.GetUnescapedValue()) << key;
+      }
+    }
+    EXPECT_EQ(count, 1) << key;
+  }
+}
