+void BrowserView::RefreshNoventraSpaceTheme() {
+  if (!initialized_ || !GetWidget() || GetWidget()->IsClosed() ||
+      GetProfile()->ShutdownStarted() ||
+      noventra_space_theme_refresh_pending_) {
+    return;
+  }
+  noventra_space_theme_refresh_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<BrowserView> self) {
+                       if (!self) {
+                         return;
+                       }
+                       self->noventra_space_theme_refresh_pending_ = false;
+                       if (self->GetProfile()->ShutdownStarted()) {
+                         return;
+                       }
+                       const auto* theme =
+                           noventra::GetSpaceTheme(self->browser());
+                       const std::string id(theme ? theme->id : "");
+                       if (self->noventra_space_theme_ == id) {
+                         return;
+                       }
+                       self->noventra_space_theme_ = id;
+                       self->RefreshNoventraGlassAppearance();
+                     },
+                     weak_ptr_factory_.GetWeakPtr()));
 }
 
