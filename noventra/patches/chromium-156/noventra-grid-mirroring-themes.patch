+void TabStripModel::UpdateSplitGridRowRatio(split_tabs::SplitTabId split_id,
+                                            double row_ratio,
+                                            bool is_intermediate) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  split_tabs::SplitTabData* split_data = GetSplitData(split_id);
+  if (split_data->visual_data()->split_layout() !=
+          split_tabs::SplitTabLayout::kGrid ||
+      !(row_ratio >= 0.0 && row_ratio <= 1.0) ||
+      split_data->visual_data()->grid_row_ratio() == row_ratio) {
+    return;
+  }
+  const split_tabs::SplitTabVisualData old_visual_data =
+      *split_data->visual_data();
+  split_data->visual_data()->set_grid_row_ratio(row_ratio);
+  NotifySplitTabVisualsChanged(
+      split_id, old_visual_data, *split_data->visual_data(),
+      SplitTabChange::SplitVisualChangeReason::kRatioUpdated, is_intermediate);
+}
