+    if (const auto* version = value->FindString("version")) {
+      result.version = *version;
+    }
+  } else if (*status == "busy") {
     result.status = VersionUpdater::DEFERRED;
     if (const auto* version = value->FindString("version")) {
       result.version = *version;
