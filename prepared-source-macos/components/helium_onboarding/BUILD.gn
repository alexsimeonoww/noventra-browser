import("//tools/grit/grit_rule.gni")

localized_strings_header =
    "$target_gen_dir/helium_onboarding_localized_strings.h"

action("localized_strings") {
  script = "//third_party/node/node.py"

  inputs = [
    "helium_onboarding_strings.grdp",
    "util/generate-i18n.mts",
    "util/localized-strings.h.in",
    "util/strings.ts.in",
  ]

  outputs = [ localized_strings_header ]

  args = [
    rebase_path("util/generate-i18n.mts", root_build_dir),
    rebase_path(localized_strings_header, root_build_dir),
  ]
}

action("build") {
  script = "//third_party/node/node.py"
  dist_dir = "$target_gen_dir/dist"

  args = [
    rebase_path("node_modules/vite/bin/vite.js"),
    "build",
    rebase_path("."),
    "--emptyOutDir",
    "--outDir",
    rebase_path(dist_dir),
  ]

  # Track source files explicitly so new custom controls rebuild reliably.
  # src/lib/strings.ts is generated by :localized_strings before this action;
  # track its GRDP and template instead of requiring a pre-existing source file.
  inputs = [
    "helium_onboarding_strings.grdp",
    "index.html",
    "package.json",
    "pnpm-lock.yaml",
    "public/favicon.png",
    "src/App.svelte",
    "src/NoventraOnboarding.svelte",
    "src/app.css",
    "src/components/BrowserImportGraphic.svelte",
    "src/components/BrowserProfileGroup.svelte",
    "src/components/DefaultBrowserOption.svelte",
    "src/components/HeliumPartner.svelte",
    "src/components/ImportNotice.svelte",
    "src/components/ImportPrompt.svelte",
    "src/components/MacImportNotice.svelte",
    "src/components/NoventraLogo.svelte",
    "src/components/NoventraPasswordManagers.svelte",
    "src/components/PageHeader.svelte",
    "src/components/PageNavigation.svelte",
    "src/components/PasswordManagerOption.svelte",
    "src/components/PreferenceToggle.svelte",
    "src/components/ProfileImportOption.svelte",
    "src/components/SearchEngineItem.svelte",
    "src/icons/tabler/IconKey.svelte",
    "src/icons/tabler/IconLockStar.svelte",
    "src/icons/tabler/IconReload.svelte",
    "src/icons/tabler/IconShieldCheck.svelte",
    "src/icons/tabler/IconShieldExclamation.svelte",
    "src/icons/tabler/IconShieldOff.svelte",
    "src/icons/tabler/IconShieldQuestion.svelte",
    "src/icons/tabler/IconTransferIn.svelte",
    "src/icons/tabler/IconWorldHeart.svelte",
    "src/icons/tabler/LICENSE",
    "src/lib/browser/extensions.ts",
    "src/lib/browser/importer.ts",
    "src/lib/browser/index.ts",
    "src/lib/browser/is-default.ts",
    "src/lib/browser/prefs.ts",
    "src/lib/browser/profile.ts",
    "src/lib/browser/search-engines.ts",
    "src/lib/browser/setup.ts",
    "src/lib/chrome-send-polyfill.ts",
    "src/lib/cr/LICENSE",
    "src/lib/cr/assert.ts",
    "src/lib/cr/cr.d.ts",
    "src/lib/cr/cr.ts",
    "src/lib/cr/default_browser_browser_proxy.ts",
    "src/lib/cr/import_data_browser_proxy.ts",
    "src/lib/cr/index.ts",
    "src/lib/cr/promise_resolver.ts",
    "src/lib/cr/search_engines_browser_proxy.ts",
    "src/lib/i18n.ts",
    "src/lib/nonfree-icons.ts",
    "src/lib/onboarding-flow.ts",
    "src/lib/password-managers.ts",
    "src/lib/platform.ts",
    "src/lib/search-engine-config.ts",
    "src/main.ts",
    "src/pages/DataImport.svelte",
    "src/pages/DefaultBrowser.svelte",
    "src/pages/Finish.svelte",
    "src/pages/HeliumServices.svelte",
    "src/pages/PasswordManager.svelte",
    "src/pages/SearchEngine.svelte",
    "src/pages/Welcome.svelte",
    "src/pages/index.ts",
    "src/vite-env.d.ts",
    "svelte.config.js",
    "util/strings.ts.in",
    "vite.config.ts",
  ]

  deps = [ ":localized_strings" ]
  outputs = [ "$dist_dir/index.html" ]
}

action("grit") {
  script = "//third_party/node/node.py"
  node_script = "./util/generate-grd.mts"
  dist_dir = "$target_gen_dir/dist"

  args = [
    rebase_path(node_script),
    rebase_path(dist_dir),
    rebase_path("$target_gen_dir/resources.grd"),
  ]

  inputs = [
    node_script,
    "$dist_dir/index.html",
  ]

  outputs = [ "$target_gen_dir/resources.grd" ]
  deps = [ ":build" ]
}

grit("generated_resources") {
  source = "$target_gen_dir/resources.grd"

  # Required because the .grd is generated.
  enable_input_discovery_for_gn_analyze = false
  use_brotli = true

  output_dir = "$target_gen_dir/resources"

  outputs = [
    "grit/helium_onboarding_generated.h",
    "grit/helium_onboarding_generated_map.cc",
    "grit/helium_onboarding_generated_map.h",
    "helium_onboarding_generated.pak",
  ]

  deps = [ ":grit" ]
}
