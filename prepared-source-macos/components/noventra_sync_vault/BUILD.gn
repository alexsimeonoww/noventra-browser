import("//testing/test.gni")
import("//third_party/protobuf/proto_library.gni")

proto_library("sync_vault_proto") {
  proto_in_dir = "//"
  sources = [ "sync_vault.proto" ]
  extra_configs = [ "//build/config/compiler:wexit_time_destructors" ]
}

source_set("sync_vault") {
  sources = [
    "sync_vault_cryptographer.cc",
    "sync_vault_cryptographer.h",
    "sync_vault_format.cc",
    "sync_vault_format.h",
    "sync_vault_limits.h",
    "sync_vault_state_codec.h",
    "sync_vault_store.cc",
    "sync_vault_store.h",
    "sync_vault_transport.h",
  ]

  public_deps = [
    "//base",
    "//crypto",
  ]

  deps = [ ":sync_vault_proto" ]
}

# Runnable in isolation, without linking the Chromium browser test suites.
test("sync_vault_store_unittests") {
  sources = [
    "sync_vault_compatibility_unittest.cc",
    "sync_vault_store_unittest.cc",
  ]
  deps = [
    ":sync_vault",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//crypto",
    "//testing/gtest",
  ]
}
